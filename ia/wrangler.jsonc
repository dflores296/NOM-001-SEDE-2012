// La configuración del Worker del asistente (agente.js). Cloudflare la lee al
// publicar: desde el repositorio conectado (Workers Builds, con «ia» como
// directorio raíz) o con `npx wrangler deploy` dentro de esta carpeta.
// Ver ia/README.md.
{
  // Tiene que llamarse igual que el Worker en el panel de Cloudflare. De
  // aquí sale su dirección: https://nom-001-ia.<subdominio>.workers.dev
  "name": "nom-001-ia",
  "main": "agente.js",
  "compatibility_date": "2026-09-01",

  // Workers AI, el que corre el modelo. Sin tarjeta, la cuenta se queda en
  // el plan gratis: 10 000 neuronas al día y al acabarse deja de contestar,
  // no cobra.
  "ai": { "binding": "AI" },

  "vars": {
    // El que escoge qué leer (pasos 1 y 2) y el que redacta (paso 3). Si
    // Cloudflare saca uno del plan gratis (su error 5035), se cambia aquí por
    // otro del catálogo que siga gratis. Si falla el que redacta, redacta el
    // otro.
    "MODELO": "@cf/openai/gpt-oss-20b",
    "MODELO_REDACTAR": "@cf/openai/gpt-oss-120b",
    // Las páginas que pueden usarlo. Con un dominio propio, se agrega aquí.
    "ORIGENES": "https://dflores296.github.io"
  },

  // Un tope por conexión (dirección IP) y por minuto, contra quien quiera
  // saturar el asistente o acabarse el cupo de golpe desde una sola máquina:
  // 15 consultas por minuto, unas 5 preguntas (cada una son 3). Una persona
  // tarda de 10 a 30 segundos por pregunta, así que no lo nota. Cloudflare
  // lleva la cuenta en memoria, por centro de datos; el Worker no anota ni
  // guarda la IP. namespace_id es cualquier número, único en la cuenta.
  "ratelimits": [
    { "name": "TOPE_IP", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } }
  ],

  // El registro de Cloudflare (Workers & Pages → nom-001-ia → Observability)
  // guarda solo lo que el Worker escribe: el error del modelo, lo que tardó y
  // gastó cada consulta, y los eventos «pregunta» (con el número de orden del
  // día) y «respuesta_generada» (con el modelo); nunca la pregunta, la
  // respuesta ni la IP. Sin los registros por petición, que traerían datos de
  // cada petición. El candado del aviso de privacidad
  // (site/pruebas/aviso.mjs) falla si se encienden.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  "workers_dev": true,
  // Las versiones de prueba de cada rama no hacen falta: el asistente se
  // prueba con la página, y cada URL de prueba sería otra puerta a la cuota.
  "preview_urls": false
}
