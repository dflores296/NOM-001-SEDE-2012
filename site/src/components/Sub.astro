---
// Inciso anidado (a) → (1) → a.  Se llama a sí mismo para los niveles inferiores.
import Tabla from './Tabla.astro';
import { linkify, BASE, tablaPorId } from '../lib/nom.js';
const { node } = Astro.props;
// El marcador se decide por el TIPO de inciso, no por su profundidad: la
// misma "a." puede aparecer a distintos niveles según el artículo.
const label = node.kind === 'letter' ? `${node.label}.` : `(${node.label})`;
// Notas y excepciones se intercalan en la norma y su orden importa: se
// reordenan por su posición original en el documento, no por tipo.
// `parrafos` son los párrafos que en el documento van DESPUÉS de una nota o
// excepción. No caben en `text`, que se pinta antes: la Excepción de 922-56(b)
// precede al párrafo que introduce su tabla de factores, y al revés se lee mal.
const anot = [
  ...(node.notes || []).map((n) => ({ ...n, k: 'nota' })),
  ...(node.exceptions || []).map((n) => ({ ...n, k: 'exc' })),
  ...(node.parrafos || []).map((n) => ({ ...n, k: 'parr' })),
].sort((a, b) => (a.seq ?? 0) - (b.seq ?? 0));

// Las tablas de este inciso, en el orden en que aparecen en la norma. Van
// después del texto y antes de los incisos hijos, que es donde el documento
// las imprime: el parser las enganchó al nodo vigente cuando pasó por ellas.
const tabs = (node.tables || [])
  .map((t) => tablaPorId.get(t.id))
  .filter(Boolean);
---
<li class="sub" id={node.id}>
  <span class="lbl">{label}</span>
  {node.title && <span class="st">{node.title}. </span>}
  <span set:html={linkify(node.text)} />

  {node.figures?.map((f) => (
    <figure class="fig">
      <img src={`${BASE}/img/${f.src}`} alt={f.caption || `Figura de la página ${f.page} del PDF`}
           width={Math.round(f.w * 4 / 3)} height={Math.round(f.h * 4 / 3)} loading="lazy" />
      <figcaption>{f.caption || `Página ${f.page} del PDF`}</figcaption>
    </figure>
  ))}

  {node.definitions?.length > 0 && (
    <dl class="defs-sec">
      {node.definitions.map((d) => (
        <div><dt>{d.term}</dt><dd set:html={linkify(d.text)} /></div>
      ))}
    </dl>
  )}

  {anot.map((n) => (n.k === 'parr' ? (
    <p class="parr" set:html={linkify(n.text)} />
  ) : (
    <div class={n.k}>
      <span class="lb">{n.label}</span><span set:html={linkify(n.text)} />
      {n.items?.length > 0 && (
        <ul class="anot-items">
          {n.items.map((it) => (
            <li><span class="lbl">({it.label})</span> <span set:html={linkify(it.text)} /></li>
          ))}
        </ul>
      )}
    </div>
  )))}

  {tabs.map((t) => <Tabla t={t} />)}

  {node.children?.length > 0 && (
    <ul class="subs">
      {node.children.map((c) => <Astro.self node={c} />)}
    </ul>
  )}
</li>
