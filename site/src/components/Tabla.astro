---
import { linkify, tablaSlug, rotuloTabla, subtituloTabla } from '../lib/nom.js';
const { t } = Astro.props;
const head = t.rows.slice(0, t.header_rows || 0);
const body = t.rows.slice(t.header_rows || 0);
// Una tabla contrastada a ojo contra el PDF ya no es una estimación: no
// tiene sentido pedirle al lector que haga la comprobación que ya se hizo.
const dudosa = t.quality < 0.8 && !t.verificada;

// Una celda que abarca varias columnas encabeza un GRUPO de columnas, no una
// sola: `scope` se lo dice a los lectores de pantalla, que si no leen el
// título equivocado en cada dato.
const alcance = (c) => (c.cs > 1 ? 'colgroup' : 'col');

// Las celdas se miden por su contenido y no envuelven, para que "0.824 – 1.31"
// no se parta en dos renglones. Pero la norma mete párrafos enteros en alguna
// celda —"Tres de algodón, uno exterior retardante de la flama y resistente a
// la humedad"—, y esas sí tienen que envolver o la tabla se va a metros de
// ancho. El corte está por encima de la frase más larga que conviene dejar
// entera ("Alambrado para artefactos", "Cubierta no metálica").
const larga = (c) => ((c.t || '').length > 28 ? 'larga' : undefined);
---
<figure class="tabla" id={tablaSlug(t.id)}>
  <figcaption>
    <span class="tid">{rotuloTabla(t)}</span>
    {subtituloTabla(t)}
    {/* La norma advierte en el propio título que estas tablas son
        informativas y no normativas. Es un dato de peso distinto al nombre
        de la tabla, así que se muestra aparte y no diluido en la frase. */}
    {t.informativa && (
      <span
        class="tag-info"
        title="La norma señala que esta tabla no es parte de sus requerimientos y especificaciones; se incluye únicamente con propósitos informativos."
      >Informativa</span>
    )}
    <a class="anchor" href={`#${tablaSlug(t.id)}`} aria-label="Enlace a esta tabla">#</a>
  </figcaption>

  {t.informativa && (
    <p class="tabla-info">
      <b>No es parte de los requerimientos de la NOM.</b> La norma la incluye
      únicamente con propósitos informativos, así que no se puede invocar como
      exigencia en una verificación.
    </p>
  )}

  {dudosa && (
    <p class="tabla-aviso">
      La separación en columnas de esta tabla no pudo reconstruirse con
      confianza desde el PDF. Contrástala con la página {t.pages[0]} del
      documento original antes de usarla.
    </p>
  )}

  {/* La caja se ciñe a la tabla en lugar de ocupar la columna entera: un
      marco a todo lo ancho alrededor de una tabla de dos columnas se lee como
      si faltara contenido a los lados. */}
  <div class="tabla-caja">
  {/* En el PDF esta frase es una celda fusionada a todo lo ancho, encima del
      encabezado. Repartida en celdas quedaba como títulos de columna sin
      sentido, así que se presenta como lo que es: la entrada a la tabla. */}
  {t.intro && <p class="tabla-intro" set:html={linkify(t.intro)} />}

  <div class="tabla-scroll">
    <table>
      {head.length > 0 && (
        <thead>
          {head.map((r) => (
            <tr>
              {r.map((c) => (
                <th colspan={c.cs} rowspan={c.rs} scope={alcance(c)} set:html={linkify(c.t)} />
              ))}
            </tr>
          ))}
        </thead>
      )}
      <tbody>
        {body.map((r) => (
          <tr>
            {r.map((c) => (
              <td colspan={c.cs} rowspan={c.rs} class={larga(c)} set:html={linkify(c.t)} />
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  </div>

  {t.notes?.length > 0 && (
    <div class="tabla-notas">
      {t.notes.map((n) => <p set:html={linkify(n)} />)}
    </div>
  )}

  <div class="tabla-pie">
    {t.verificada && (
      <><span class="tag-ok" title={`Contrastada celda por celda contra la página ${t.pages.join(', ')} del PDF el ${t.verificada}.`}
        >Verificada contra el PDF</span>{' · '}</>
    )}
    {t.rows.length} filas · {t.cols} columnas · página{t.pages.length > 1 ? 's' : ''}{' '}
    {t.pages.join(', ')} del PDF ·{' '}
    <a
      href={`https://github.com/dflores296/NOM-001-SEDE-2012/issues/new?title=${
        encodeURIComponent(rotuloTabla(t) + ': revisar valores')
      }&body=${encodeURIComponent(
        rotuloTabla(t) + ' (página ' + t.pages.join(', ') + ' del PDF)\n\n' +
        'Qué está mal:\n\nQué dice el PDF:\n'
      )}`}
      rel="noopener"
      target="_blank"
    >¿Ves un error? Repórtalo</a>
  </div>
</figure>
