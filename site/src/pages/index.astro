---
import Base from '../layouts/Base.astro';
import { articles, chapters, corpus, grafo, definiciones, tablas } from '../lib/nom.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nSec = articles.reduce((n, a) => n + a.sections.length, 0);
const top = grafo.mas_citados.filter((r) => !r.id.startsWith('cap:')).slice(0, 8);
// Las tablas del Capítulo 10 no cuelgan de ningún artículo y se publican
// juntas en /tablas.
const cap10 = tablas.filter((t) => t.article == null);
const verificadas = tablas.filter((t) => t.verificada).length;
---

<Base title="NOM-001-SEDE-2012 — Guía interactiva">
  <div class="wrap">
    <div class="hero">
      <h1>NOM-001-SEDE-2012</h1>
      <p>
        Instalaciones Eléctricas (utilización). Las 780 páginas de la norma, con sus referencias
        cruzadas convertidas en enlaces navegables y búsqueda instantánea. Pulsa <b>/</b> para
        buscar desde cualquier página.
      </p>
      <div class="stats">
        <div class="stat"><b>{articles.length}</b><span>Artículos</span></div>
        <div class="stat"><b>{nSec.toLocaleString('es-MX')}</b><span>Secciones</span></div>
        <div class="stat"><b>{grafo.meta.aristas.toLocaleString('es-MX')}</b><span>Referencias enlazadas</span></div>
        <div class="stat"><b>{definiciones.length}</b><span>Definiciones</span></div>
      </div>
    </div>

    {/* Mientras las tablas se reconstruían a ciegas, este aviso pedía
        desconfiar de todas. Ya no: las {tablas.length} se contrastaron celda
        por celda contra el PDF. El aviso se queda, pero para decir qué se
        revisó y qué sigue siendo responsabilidad del lector. Si alguna tabla
        volviera a quedar sin contrastar, el texto lo dice en vez de callarlo. */}
    {verificadas === tablas.length ? (
      <div class="aviso aviso-fuerte">
        <b>Las {tablas.length} tablas ya se contrastaron celda por celda contra el PDF.</b>
        El texto de los artículos se extrajo con una cobertura verificada del 99.96 %, y las
        tablas —que se reconstruyen automáticamente y por eso eran la parte más frágil— se
        revisaron una por una sobre el documento original. Aun así, esta no es una edición
        oficial: ante cualquier duda prevalece el DOF, y si ves una diferencia
        <a href={`${base}/tablas/`}>repórtala</a> — el proyecto mejora con quien lo usa en obra.
      </div>
    ) : (
      <div class="aviso aviso-fuerte">
        <b>Hay tablas sin contrastar.</b> {verificadas} de las {tablas.length} se revisaron
        celda por celda contra el PDF; el resto sale de la reconstrucción automática, que no es
        exacta. Contrasta con el original antes de usar un valor y consulta
        <a href={`${base}/revision/`}>qué falta revisar</a>.
      </div>
    )}

    <div class="chap">
      <h2>Los requisitos que más se citan</h2>
      <p class="meta" style="color:var(--text-faint);font-size:.84rem;margin:-.3rem 0 .7rem">
        Calculado sobre el grafo de referencias: qué exigencias sostienen al resto de la norma.
      </p>
      <div class="grid">
        {top.map((r) => (
          <a class="card" href={`${base}/art/${r.articulo}#${r.id.replace('art:', '')}`}>
            <b>{r.id.startsWith('art:') ? `Artículo ${r.id.slice(4)}` : r.id}</b>
            <span>{r.titulo}</span>
            <em>{r.citas} referencias</em>
          </a>
        ))}
      </div>
    </div>

    {chapters.map((c) => {
      const arts = articles.filter((a) => a.chapter === c.num);
      if (!arts.length) return null;
      return (
        <div class="chap" id={`cap${c.num}`}>
          <h2><span>Capítulo {c.num}</span>{c.title}</h2>
          <div class="grid">
            {arts.map((a) => (
              /* El Artículo 100 no tiene secciones numeradas: es el glosario,
                 y se consulta desde su propia página. */
              <a class="card" href={a.num === 100 ? `${base}/glosario/` : `${base}/art/${a.num}`}>
                <b>{a.num}</b>
                <span>{a.title}</span>
                <em>
                  {a.num === 100
                    ? `${definiciones.length} definiciones`
                    : `${a.sections.length} secciones`}
                </em>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <div class="chap" id="cap10">
      <h2><span>Capítulo 10</span>Tablas generales</h2>
      <div class="grid">
        <a class="card" href={`${base}/tablas/`}>
          <b>10</b>
          <span>Tablas generales</span>
          <em>{cap10.length} tablas</em>
        </a>
      </div>
    </div>
  </div>
</Base>
