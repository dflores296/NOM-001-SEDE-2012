---
import Base from '../layouts/Base.astro';
import { articles, chapters, grafo, definiciones, tablas, validacion, byNum, linkify,
         tablaSlug, tablaPorId, figuras, apendices, titulosFinales } from '../lib/nom.js';
import { defSlug } from '../lib/slug.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nSec = articles.reduce((n, a) => n + a.sections.length, 0);
const top = grafo.mas_citados.filter((r) => !r.id.startsWith('cap:')).slice(0, 8);
const maxCitas = top.length ? top[0].citas : 1;
// Las tablas del Capítulo 10 no cuelgan de ningún artículo y se publican
// juntas en /tablas.
const cap10 = tablas.filter((t) => t.article == null && !t.apendice);
const verificadas = tablas.filter((t) => t.verificada).length;
const todoVerificado = verificadas === tablas.length;
const formulas = figuras.filter((f) => !f.rotulos?.length).length;

// ------------------------------------------------- la tarjeta de la portada
// El identificador con el que la norma se cita a sí misma es la idea sobre la
// que está hecha la guía: es la URL, el ancla, la clave del grafo y la unidad
// de búsqueda. La tarjeta lo desarma con un inciso real y muestra su texto.
const MUESTRA = '250-32(b)(1)';
const buscaNodo = (nodos, id) => {
  for (const n of nodos || []) {
    if (n.id === id) return n;
    const h = buscaNodo(n.children, id);
    if (h) return h;
  }
  return null;
};
const artMuestra = byNum.get(250);
const nodo = buscaNodo(artMuestra?.sections, MUESTRA);
const recorta = (t, n) => (t.length > n ? t.slice(0, t.lastIndexOf(' ', n)) + '…' : t);
const textoMuestra = nodo ? recorta(nodo.text || '', 230) : '';

// Atajos de ejemplo bajo el buscador. Solo se pintan si su destino existe:
// un ejemplo que lleva a un ancla muerta es peor que ninguno.
const atajos = [
  tablaPorId.get('310-15(b)(16)') && {
    txt: 'Tabla 310-15(b)(16)', href: `${base}/art/310/#${tablaSlug('310-15(b)(16)')}`,
  },
  tablaPorId.get('430-250') && {
    txt: 'Tabla 430-250', href: `${base}/art/430/#${tablaSlug('430-250')}`,
  },
  definiciones.some((d) => d.term === 'Acometida') && {
    txt: 'Acometida', href: `${base}/glosario/#${defSlug('Acometida')}`,
  },
  { txt: '250-122', href: `${base}/art/250/#250-122` },
].filter(Boolean);

const EXPLORA = [
  { ey: `${articles.length} artículos`, t: 'El articulado', d: 'Un artículo por página, con su índice de secciones y quién cita a cada una.', href: `${base}/#indice` },
  { ey: `${tablas.length} tablas`, t: 'Tablas', d: 'Ampacidades, factores y dimensiones como datos, contrastados celda por celda contra el PDF.', href: `${base}/tablas/` },
  { ey: `${validacion.figuras_numeradas} figuras · ${formulas} fórmulas`, t: 'Figuras', d: 'Cada una con su número y su leyenda, y el texto que el DOF dibuja dentro de la imagen.', href: `${base}/figuras/` },
  { ey: `${definiciones.length} definiciones`, t: 'Glosario', d: 'El Artículo 100 completo, enlazado desde cada lugar donde la norma usa el término.', href: `${base}/glosario/` },
  { ey: `${apendices.length} apéndices · ${titulosFinales.length} títulos`, t: 'Apéndices y cierre', d: 'Las 38 páginas que siguen al Artículo 924: vigilancia, bibliografía y los apéndices informativos.', href: `${base}/apendices/` },
  { ey: 'Observaciones', t: 'Reporta una diferencia', d: 'Si algo no coincide con el DOF, cada artículo, tabla y figura tiene un enlace para avisar.', href: `${base}/observaciones/` },
];
---

<Base title="NOM-001-SEDE-2012 — Guía interactiva">
  <!-- ------------------------------------------------------------ portada
       Banda de color a todo lo ancho con el título y el buscador, que es la
       acción principal del sitio. Es la única superficie de color de toda la
       guía. -->
  <section class="portada">
    <div class="portada-in">
      <p class="portada-ey"><i></i>Instalaciones Eléctricas (utilización) · DOF, 29 de noviembre de 2012</p>
      <h1>La NOM-001-SEDE-2012, sin hojear 780&nbsp;páginas</h1>
      <p class="portada-sub">
        Cada artículo en su página, {grafo.meta.aristas.toLocaleString('es-MX')} referencias cruzadas
        que se siguen con un clic y una búsqueda que funciona sin señal, en obra.
      </p>

      <form class="hero-buscar" role="search">
        <div class="search-wrap">
          <svg class="lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input data-buscar type="search" autocomplete="off" spellcheck="false"
                 placeholder="Busca 250-32, ampacidad, falla a tierra…" aria-label="Buscar en la norma" />
          <button class="ir" type="submit" aria-label="Buscar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
          <div class="results" role="listbox"></div>
        </div>
      </form>

      <p class="atajos">
        <span>Prueba con</span>
        {atajos.map((x) => <a href={x.href}>{x.txt}</a>)}
      </p>
    </div>
  </section>

  <div class="wrap">
    <!-- ------------------------------------------- el identificador, desarmado -->
    {nodo && (
      <article class="muestra" aria-label={`Cómo se lee el identificador ${MUESTRA}`}>
        <div class="muestra-barra">
          <span>Capítulo {artMuestra.chapter} · Artículo 250 · {artMuestra.title}</span>
          <span class="muestra-pag">Así se cita la norma a sí misma</span>
        </div>
        <div class="muestra-cuerpo">
          <div class="anatomia" aria-hidden="true">
            <span class="seg seg-art"><code>250</code><small>Artículo</small></span>
            <span class="seg seg-sec"><code>-32</code><small>Sección</small></span>
            <span class="seg seg-inc"><code>(b)(1)</code><small>Incisos</small></span>
          </div>
          <div class="muestra-texto">
            <p class="muestra-tit">{nodo.title}</p>
            <p set:html={linkify(textoMuestra)} />
            <p class="muestra-pie">
              Ese mismo identificador es la dirección de la página, el ancla del enlace,
              la clave del grafo de referencias y lo que se escribe en el buscador.
            </p>
            <a class="muestra-ir" href={`${base}/art/250/#${MUESTRA}`}>Abrir {MUESTRA} en el Artículo 250 →</a>
          </div>
        </div>
      </article>
    )}

    <!-- ------------------------------------------------------------- cifras -->
    <div class="cifras">
      <div class="cifra"><b>{articles.length}</b><span>Artículos</span></div>
      <div class="cifra"><b>{nSec.toLocaleString('es-MX')}</b><span>Secciones</span></div>
      <div class="cifra"><b>{grafo.meta.aristas.toLocaleString('es-MX')}</b><span>Referencias enlazadas</span></div>
      <div class="cifra"><b>{definiciones.length}</b><span>Definiciones</span></div>
      <div class="cifra"><b>{tablas.length}</b><span>Tablas reconstruidas</span></div>
      <div class="cifra"><b>{validacion.figuras_numeradas}</b><span>Figuras</span></div>
    </div>

    {/* Mientras las tablas se reconstruían a ciegas, este aviso pedía
        desconfiar de todas. Ya no: las {tablas.length} se contrastaron celda
        por celda contra el PDF. La franja de estado se queda para decir qué
        se revisó y qué sigue siendo responsabilidad del lector. Si alguna
        tabla volviera a quedar sin contrastar, el punto de la ficha se pone
        en ámbar en vez de callarlo. */}
    <div class="estado">
      <span class:list={['chip', { warn: !todoVerificado }]}>
        <span class="dot"></span>Tablas verificadas <b class="tabular">{verificadas}/{tablas.length}</b>
      </span>
      <span class="chip"><span class="dot"></span>Cobertura de texto <b class="tabular">{validacion.cobertura_pct}%</b></span>
      <span class="chip"><span class="dot"></span>Referencias rotas <b class="tabular">{grafo.meta.referencias_rotas}</b></span>
    </div>
    <div class="nota aviso-dof">
      <span class="lb">No es una edición oficial</span>
      {todoVerificado ? (
        <span>
          Reproducción con fines de consulta: ante cualquier duda prevalece el DOF. Si ves una
          diferencia, <a href={`${base}/observaciones/`}>repórtala</a>; el proyecto mejora con quien lo
          usa en obra.
        </span>
      ) : (
        <span>
          El resto sale de la reconstrucción automática, que no es exacta. Contrasta con el
          original antes de usar un valor y <a href={`${base}/observaciones/`}>repórtanos</a>
          cualquier diferencia.
        </span>
      )}
    </div>

    <!-- ------------------------------------------------------------ explora -->
    <div class="sec">
      <div class="sec-head"><h2><span class="n">Explora</span>Todo lo que trae la norma</h2></div>
      <div class="explora">
        {EXPLORA.map((x) => (
          <a class="exp" href={x.href}>
            <span class="exp-ey">{x.ey}</span>
            <span class="exp-t">{x.t}</span>
            <span class="exp-d">{x.d}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ------------------------------------------------------------ ranking -->
    <div class="sec">
      <div class="sec-head">
        <h2><span class="n">Más citados</span>Los requisitos a los que más remite la norma</h2>
        <span class="desc">Calculado sobre el grafo de referencias</span>
      </div>
      <ol class="rank">
        {top.map((r, i) => (
          <li>
            <a href={`${base}/art/${r.articulo}#${r.id.replace('art:', '')}`}>
              <span class="rank-i tabular">{i + 1}</span>
              <span class="rank-id">{r.id.startsWith('art:') ? `Artículo ${r.id.slice(4)}` : r.id}</span>
              <span class="rank-t">{r.titulo}</span>
              <span class="rank-bar"><i style={`width:${Math.round((r.citas / maxCitas) * 100)}%`}></i></span>
              <span class="rank-n tabular">{r.citas}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <!-- ------------------------------------------------------------- índice -->
    <div class="sec" id="indice">
      <div class="sec-head">
        <h2><span class="n">Índice</span>Los diez capítulos</h2>
        <span class="desc">{articles.length} artículos · {nSec.toLocaleString('es-MX')} secciones</span>
      </div>
      <div class="capitulos">
        {chapters.map((c) => {
          const arts = articles.filter((a) => a.chapter === c.num);
          if (!arts.length) return null;
          return (
            <section class="cap" id={`cap${c.num}`}>
              <header>
                <span class="cap-ey">Capítulo {c.num}</span>
                <h3>{c.title}</h3>
                <span class="cap-n">{arts.length} {arts.length === 1 ? 'artículo' : 'artículos'}</span>
              </header>
              <div class="cap-lista">
                {arts.map((a) => (
                  /* El Artículo 100 no tiene secciones numeradas: es el
                     glosario, y se consulta desde su propia página. */
                  <a href={a.num === 100 ? `${base}/glosario/` : `${base}/art/${a.num}`}>
                    <b>{a.num}</b>
                    <span>{a.title}</span>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
        <section class="cap" id="cap10">
          <header>
            <span class="cap-ey">Capítulo 10</span>
            <h3>Tablas generales</h3>
            <span class="cap-n">{cap10.length} tablas</span>
          </header>
          <div class="cap-lista">
            <a href={`${base}/tablas/generales/`}><b>10</b><span>Tablas generales y sus notas</span></a>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ---------------------------------------------------------------- portada */
  .portada {
    background: var(--hero-bg); color: var(--hero-text);
    padding: 4.5rem var(--gut) 9rem; text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .portada-in { max-width: 760px; margin: 0 auto; }
  .portada-ey {
    display: block; margin: 0 0 1.4rem; line-height: 1.6;
    font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--hero-dim);
  }
  .portada-ey i { display: inline-block; width: 6px; height: 6px; margin-right: 0.5rem; vertical-align: 2px; border-radius: 50%; background: currentColor; }
  .portada h1 {
    margin: 0; font-size: clamp(2.25rem, 5.4vw, 3.6rem); font-weight: 600;
    line-height: 1.08; letter-spacing: -0.025em; text-wrap: balance;
  }
  .portada-sub {
    margin: 1.2rem auto 0; max-width: 58ch; font-size: 1.125rem; line-height: 1.6;
    color: var(--hero-dim); text-wrap: pretty;
  }

  /* El buscador grande: campo blanco con el botón redondo y oscuro adentro,
     como el campo de correo de la portada de Mintlify. */
  .hero-buscar { margin: 2.2rem auto 0; max-width: 600px; }
  .hero-buscar .search-wrap { max-width: none; }
  .hero-buscar .search-wrap input {
    height: 56px; padding: 0 3.6rem 0 2.9rem; font-size: 1rem;
    background: var(--panel); border-color: transparent; border-radius: var(--radius-xl);
  }
  .hero-buscar .search-wrap input:focus { border-color: var(--accent); }
  .hero-buscar .lupa { left: 1.05rem; width: 18px; height: 18px; }
  .hero-buscar .ir {
    position: absolute; right: 8px; top: 8px; width: 40px; height: 40px;
    display: grid; place-items: center; cursor: pointer;
    border: 0; border-radius: 50%; background: var(--text); color: var(--panel);
  }
  .hero-buscar .ir svg { width: 18px; height: 18px; }
  .hero-buscar .ir:hover { background: color-mix(in srgb, var(--text) 82%, var(--panel)); }
  .hero-buscar .ir:focus-visible { outline: 2px solid var(--hero-text); outline-offset: 2px; }
  :root[data-theme="oscuro"] .hero-buscar .search-wrap input { border-color: var(--border); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme]) .hero-buscar .search-wrap input { border-color: var(--border); } }

  .atajos {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.5rem;
    margin: 1.1rem 0 0; font-size: 0.8125rem; color: var(--hero-dim);
  }
  .atajos a {
    color: var(--hero-text); font-family: var(--mono); font-size: 0.78rem; letter-spacing: normal;
    padding: 0.2rem 0.55rem; border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--hero-text) 28%, transparent);
  }
  .atajos a:hover { background: color-mix(in srgb, var(--hero-text) 12%, transparent); text-decoration: none; }

  /* ------------------------------------------------------- tarjeta flotante
     Se monta sobre el borde de la banda, como la captura del producto en la
     portada de Mintlify: es el puente entre la banda de color y la página. */
  .muestra {
    position: relative; margin: -6rem auto 0; max-width: 980px;
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-2xl);
    box-shadow: 0 2px 4px rgba(8, 9, 10, 0.04), 0 24px 48px -28px rgba(8, 9, 10, 0.28);
    overflow: hidden; text-align: left;
  }
  :root[data-theme="oscuro"] .muestra { box-shadow: none; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme]) .muestra { box-shadow: none; } }
  .muestra-barra {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--border-soft);
    background: var(--bg-soft); font-size: 0.8125rem; color: var(--text-dim);
  }
  .muestra-pag { color: var(--accent); font-weight: 600; }
  .muestra-cuerpo { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2.5rem; padding: 2rem 1.75rem 1.9rem; align-items: start; }

  .anatomia { display: flex; align-items: flex-start; }
  .seg { display: flex; flex-direction: column; }
  .seg code {
    font-family: var(--mono); font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 600;
    line-height: 1.1; letter-spacing: normal; padding-bottom: 0.5rem; border-bottom: 3px solid;
  }
  .seg small {
    margin-top: 0.55rem; font-size: 0.7rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-faint);
  }
  .seg-art code { color: var(--accent); border-color: var(--accent); }
  .seg-sec code { color: var(--text); border-color: var(--text); }
  .seg-inc code { color: var(--text-dim); border-color: var(--rejilla); }
  .seg + .seg { margin-left: 0.5rem; }

  .muestra-texto { font-size: 0.9375rem; line-height: 1.6; }
  .muestra-texto p { margin: 0 0 0.6rem; }
  .muestra-tit { font-weight: 600; }
  .muestra-pie { color: var(--text-faint); font-size: 0.8125rem; }
  .muestra-ir { font-weight: 600; font-size: 0.875rem; }

  @media (max-width: 820px) {
    .muestra-cuerpo { grid-template-columns: 1fr; gap: 1.6rem; padding: 1.5rem 1.25rem; }
    .muestra-barra { padding: 0.65rem 1.25rem; }
    .muestra-pag { display: none; }
  }

  /* ----------------------------------------------------------------- estado */
  .cifras { margin-top: 2.5rem; }
  .estado {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem 1.5rem;
    padding: 1rem 0 0; font-size: 0.8125rem; color: var(--text-dim);
  }
  .chip { display: inline-flex; align-items: center; gap: 0.45rem; }
  .chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
  .chip.warn .dot { background: var(--warn-br); }
  .chip b { font-family: var(--mono); color: var(--text); font-weight: 600; letter-spacing: normal; }
  .aviso-dof { margin-top: 1rem; font-size: 0.875rem; }

  /* ---------------------------------------------------------------- explora
     Tarjetas con un lavado del acento, la etiqueta arriba en versalitas y el
     título en el peso del texto. */
  .explora { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 0.9rem; }
  .exp {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1.4rem 1.5rem; border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--accent) 6%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--panel));
    color: var(--text); transition: border-color 120ms ease;
  }
  .exp:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--panel)); text-decoration: none; }
  .exp-ey { font-size: 0.75rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
  .exp-t { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.015em; }
  .exp-t::after { content: " →"; color: var(--text-faint); transition: margin 120ms ease; }
  .exp:hover .exp-t::after { color: var(--accent); }
  .exp-d { font-size: 0.9375rem; line-height: 1.55; color: var(--text-dim); }

  /* --------------------------------------------------------------- ranking
     Los "más citados" sí tienen un orden real -numérico, por peso de citas-
     así que van en una lista ordenada con su magnitud, no en tarjetas. */
  ol.rank {
    list-style: none; margin: 0; padding: 0.35rem;
    border: 1px solid var(--border); border-radius: var(--radius-xl);
  }
  ol.rank li + li { border-top: 1px solid var(--border-soft); }
  ol.rank a {
    display: grid;
    grid-template-columns: 1.6rem 7rem 1fr 7rem 2.6rem;
    align-items: center; gap: 0.9rem;
    padding: 0.7rem 0.8rem; border-radius: var(--radius-lg); color: var(--text);
  }
  ol.rank a:hover { background: var(--bg-soft); text-decoration: none; }
  .rank-i { font-family: var(--mono); color: var(--text-faint); font-size: 0.8rem; }
  .rank-id { font-family: var(--mono); color: var(--accent); font-size: 0.85rem; font-weight: 600; letter-spacing: normal; }
  .rank-t { font-size: 0.9375rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rank-bar { height: 6px; background: var(--bg-soft); border-radius: 3px; overflow: hidden; }
  .rank-bar i { display: block; height: 100%; background: var(--accent); border-radius: 3px; }
  .rank-n { font-family: var(--mono); font-size: 0.82rem; color: var(--text-dim); text-align: right; }

  /* ------------------------------------------------------------- capítulos
     Un capítulo por tarjeta, con sus artículos listados adentro. */
  /* En columnas y no en rejilla: el Capítulo 3 trae 66 artículos y el 1
     solo dos, y en una rejilla cada fila crecía a la tarjeta más alta y
     dejaba huecos. Las columnas acomodan cada tarjeta debajo de la anterior. */
  .capitulos { columns: 2 440px; column-gap: 1rem; }
  .cap {
    break-inside: avoid; margin: 0 0 1rem;
    border: 1px solid var(--border); border-radius: var(--radius-xl);
    padding: 1.25rem 1.1rem 0.9rem; scroll-margin-top: var(--ancla);
  }
  .cap header { padding: 0 0.4rem 0.8rem; margin-bottom: 0.4rem; border-bottom: 1px solid var(--border-soft); }
  .cap-ey { font-size: 0.75rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
  .cap h3 { margin: 0.2rem 0 0.15rem; font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; }
  .cap-n { font-size: 0.8125rem; color: var(--text-faint); }
  .cap-lista a {
    display: flex; gap: 0.75rem; align-items: baseline;
    padding: 0.38rem 0.4rem; border-radius: var(--radius-lg); color: var(--text-dim);
    font-size: 0.9rem; line-height: 1.4;
  }
  .cap-lista a:hover { background: var(--bg-soft); color: var(--text); text-decoration: none; }
  .cap-lista b { flex: none; min-width: 2.2rem; font-family: var(--mono); font-size: 0.8125rem; font-weight: 600; color: var(--accent); letter-spacing: normal; }

  @media (max-width: 720px) {
    .portada { padding: 3rem var(--gut) 7rem; }
    .sec-head .desc { display: none; }

    /* El título es lo que se busca leer aquí; en desktop se trunca porque
       la barra y el número lo compensan, pero en una columna angosta
