---
import Base from '../layouts/Base.astro';
import { chapters } from '../lib/nom.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Un color por capítulo, del 2 al 9: la paleta categórica de ocho tonos,
// validada contra el fondo oscuro del visor. El Capítulo 1 (disposiciones
// generales), el 10 (tablas) y los apéndices van juntos en gris: un noveno
// tono ya no se distinguiría de los otros ocho.
const GRUPOS = [
  ...chapters.filter((c) => c.num >= 2 && c.num <= 9).map((c, i) => ({
    g: String(c.num),
    nombre: `${c.num} · ${c.title}`,
    color: ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300', '#9085e9', '#e66767'][i],
  })),
  { g: 'g', nombre: '1, 10 y apéndices · General', color: '#9a9ca8' },
];
---

<Base
  title="Mapa — NOM-001-SEDE-2012"
  desc="La NOM-001-SEDE-2012 como red en 3D: cada punto es una sección y cada línea, una referencia."
>
  <div class="wrap mapa-cab">
    <h1><span class="eyebrow">Mapa</span>La norma como red</h1>
    <p>
      Cada punto es una sección y cada línea, una referencia. Los racimos son artículos; el
      color, su capítulo. Arrastra para girar, rueda para acercar y clic en un punto para ver qué
      cita y quién la cita.
    </p>
  </div>

  <div class="mapa" data-base={base} data-grupos={JSON.stringify(GRUPOS)}>
    <div class="mapa-visor">
      <div class="mapa-lienzo"></div>
      <p class="mapa-estado">Cargando el mapa…</p>

      <div class="mapa-sup">
        <form class="mapa-ir" role="search">
          <input type="search" placeholder="Ir a una sección: 250-122" aria-label="Ir a una sección del mapa"
                 autocomplete="off" spellcheck="false" />
        </form>
        <button type="button" class="mapa-reset">Ver todo</button>
        <span class="mapa-ir-msg" aria-live="polite"></span>
      </div>

      <div class="mapa-ley" role="group" aria-label="Capítulos visibles">
        {GRUPOS.map((x) => (
          <button type="button" class="chip-cap" data-g={x.g} aria-pressed="true" title="Mostrar u ocultar">
            <i style={`background:${x.color}`}></i>{x.nombre}
          </button>
        ))}
      </div>

      <aside class="mapa-panel" hidden aria-live="polite">
        <button type="button" class="mapa-cerrar" aria-label="Cerrar">×</button>
        <span class="mp-id"></span>
        <h2 class="mp-t"></h2>
        <p class="mp-art"></p>
        <a class="mp-ir">Abrir en la guía →</a>
        <div class="mp-grupo">
          <h3>La citan <b class="mp-n-in"></b></h3>
          <ul class="mp-in"></ul>
        </div>
        <div class="mp-grupo">
          <h3>Cita a <b class="mp-n-out"></b></h3>
          <ul class="mp-out"></ul>
        </div>
      </aside>
    </div>
  </div>

  {/* En el teléfono o sin mouse no se dibuja nada: ni se descargan los datos
      ni la librería 3D. */}
  <div class="wrap mapa-movil">
    <p class="nota">
      <span class="lb">Pantalla grande</span>
      <span>
        El mapa en 3D está hecho para una computadora con mouse. En el teléfono, cada sección
        dice en su apartado «Citado por» quién la cita, y el{' '}
        <a href={`${base}/`}>índice</a> lleva a cualquier artículo.
      </span>
    </p>
  </div>
</Base>

<style is:global>
  /* Globales y no con alcance: el panel y sus listas los arma el script, y
     los elementos creados así no llevan la marca de alcance de Astro. Todo
     va bajo prefijos propios (.mapa, .mp-, .chip-cap). */
  .mapa-cab { padding-top: 1.4rem; padding-bottom: 0.9rem; }
  .mapa-cab h1 { margin: 0 0 0.3rem; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .mapa-cab h1 .eyebrow { display: inline; margin: 0 0.7rem 0 0; vertical-align: 3px; }
  .mapa-cab p { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--text-dim); }

  .mapa { padding: 0 var(--gut); }
  .mapa-movil { display: none; padding-top: 1rem; padding-bottom: 2rem; }
  @media (max-width: 1023px), (pointer: coarse) {
    .mapa { display: none; }
    .mapa-movil { display: block; }
    .mapa-cab p { display: none; }
  }

  /* ------------------------------------------------------------------ visor
     Siempre oscuro, en los dos temas: los ocho tonos de la paleta solo pasan
     contraste contra fondo oscuro, y un mapa de luces se lee mejor así. La
     barra y la leyenda flotan sobre él para dejarle la pantalla entera. */
  .mapa-visor {
    position: relative; height: calc(100vh - 64px - 8.6rem); min-height: 540px;
    border-radius: var(--radius-xl); overflow: hidden;
    background: #0d0e12; border: 1px solid #2e3038; color: #ffffff;
  }
  .mapa-lienzo { position: absolute; inset: 0; }
  .mapa-estado {
    position: absolute; inset: 0; margin: 0; display: grid; place-items: center;
    font-size: 0.9375rem; color: #aeaeb7; pointer-events: none;
  }
  .mapa-estado[hidden] { display: none; }

  .mapa-sup { position: absolute; top: 14px; left: 14px; display: flex; align-items: center; gap: 0.5rem; z-index: 2; }
  .mapa-ir input {
    width: 240px; height: 34px; padding: 0 0.85rem; font: inherit; font-size: 0.875rem; letter-spacing: inherit;
    color: #ffffff; background: rgba(13, 14, 18, 0.88); border: 1px solid #2e3038; border-radius: 999px;
  }
  .mapa-ir input::placeholder { color: #aeaeb7; }
  .mapa-ir input:focus { outline: none; border-color: #0092e4; }
  .mapa-ir-msg { font-size: 0.8125rem; color: #c8cad0; text-shadow: 0 1px 2px #0d0e12; }

  .mapa-ley {
    position: absolute; left: 14px; bottom: 14px; right: 360px; z-index: 2;
    display: flex; flex-wrap: wrap; gap: 0.35rem;
  }
  .chip-cap, .mapa-reset {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 28px; padding: 0 0.7rem;
    font: inherit; font-size: 0.75rem; color: #c8cad0; cursor: pointer; white-space: nowrap;
    background: rgba(13, 14, 18, 0.85); border: 1px solid #2e3038; border-radius: 999px;
  }
  .mapa-reset { height: 34px; color: #ffffff; font-weight: 500; font-size: 0.8125rem; }
  .chip-cap i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .chip-cap[aria-pressed="false"] { opacity: 0.45; text-decoration: line-through; }
  .chip-cap:hover, .mapa-reset:hover { border-color: #aeaeb7; color: #ffffff; }

  /* Panel de la sección elegida, sobre el lado derecho del visor. */
  .mapa-panel {
    position: absolute; top: 12px; right: 12px; bottom: 12px; width: 330px; z-index: 3;
    display: flex; flex-direction: column; gap: 0.35rem; overflow-y: auto;
    padding: 1.1rem 1.2rem 1.2rem; border-radius: var(--radius-xl);
    background: rgba(13, 14, 18, 0.93); border: 1px solid #d9dae5;
    backdrop-filter: blur(6px); color: #ffffff; scrollbar-width: thin;
  }
  .mapa-panel[hidden] { display: none; }
  .mapa-cerrar {
    position: absolute; top: 8px; right: 10px; width: 28px; height: 28px; border-radius: 50%;
    font-size: 1.1rem; line-height: 1; color: #aeaeb7; background: transparent; border: 0; cursor: pointer;
  }
  .mapa-cerrar:hover { color: #ffffff; background: #141418; }
  .mp-id { font-family: var(--mono); font-size: 0.875rem; font-weight: 600; letter-spacing: normal; }
  .mp-t { margin: 0; font-size: 1.0625rem; font-weight: 600; line-height: 1.35; padding-right: 1.5rem; }
  .mp-art { margin: 0; font-size: 0.8125rem; color: #aeaeb7; }
  .mp-ir { font-size: 0.875rem; font-weight: 600; color: #0092e4; margin: 0.2rem 0 0.4rem; }
  .mp-grupo h3 {
    margin: 0.7rem 0 0.35rem; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: #aeaeb7;
  }
  .mp-grupo h3 b { color: #ffffff; }
  .mp-grupo ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .mp-grupo li button {
    width: 100%; display: flex; gap: 0.5rem; align-items: baseline; text-align: left;
    padding: 0.3rem 0.45rem; border: 0; border-radius: var(--radius); cursor: pointer;
    font: inherit; font-size: 0.8125rem; color: #c8cad0; background: transparent;
  }
  .mp-grupo li button:hover { background: #141418; color: #ffffff; }
  .mp-grupo li button i { width: 7px; height: 7px; border-radius: 50%; flex: none; align-self: center; }
  .mp-grupo li button b { font-family: var(--mono); font-weight: 600; color: #ffffff; letter-spacing: normal; flex: none; }
  .mp-grupo li button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mp-vacio { font-size: 0.8125rem; color: #aeaeb7; padding: 0.2rem 0.45rem; }

  /* La etiqueta que la librería pone junto al cursor. */
  .mapa-visor .float-tooltip-kap,
  .mapa-visor .scene-tooltip {
    padding: 0.45rem 0.65rem !important; border-radius: var(--radius-lg) !important;
    background: rgba(13, 14, 18, 0.94) !important; border: 1px solid #2e3038;
    font: 500 0.8125rem/1.4 var(--sans) !important; color: #ffffff !important; max-width: 320px;
  }
</style>

<script>
  const raiz = document.querySelector('.mapa');
  const apto = matchMedia('(min-width: 1024px) and (pointer: fine)').matches;

  if (raiz && apto) iniciar();

  async function iniciar() {
    const base = raiz.dataset.base;
    const grupos = JSON.parse(raiz.dataset.grupos);
    const color = Object.fromEntries(grupos.map((x) => [x.g, x.color]));
    const nombreGrupo = Object.fromEntries(grupos.map((x) => [x.g, x.nombre]));
    const lienzo = raiz.querySelector('.mapa-lienzo');
    const estado = raiz.querySelector('.mapa-estado');

    let ForceGraph3D, datos;
    try {
      const [mod, r] = await Promise.all([
        import('3d-force-graph'),
        fetch(`${base}/mapa.json`),
      ]);
      ForceGraph3D = mod.default;
      datos = await r.json();
    } catch (e) {
      estado.textContent = 'No se pudo cargar el mapa.';
      return;
    }

    // ------------------------------------------------------------ índices
    const porId = new Map(datos.nodes.map((n) => [n.id, n]));
    const entran = new Map(); // quién cita a cada nodo
    const salen = new Map();  // a quién cita cada nodo
    const links = datos.links.map((l) => ({ source: l.s, target: l.t, e: l.e || 0 }));
    for (const l of links) {
      if (l.e) continue;
      if (!salen.has(l.source)) salen.set(l.source, []);
      if (!entran.has(l.target)) entran.set(l.target, []);
      salen.get(l.source).push(l.target);
      entran.get(l.target).push(l.source);
    }

    const rotulo = (n) => (n.k === 'a' ? `Artículo ${n.a}` : n.k === 'h' ? n.t.split(' · ')[0] : n.id);
    const href = (n) => {
      if (n.k === 'a') return n.a === 100 ? `${base}/glosario/` : `${base}/art/${n.a}/`;
      if (n.id === 'capitulo-10') return `${base}/tablas/generales/`;
      if (n.k === 'h') return `${base}/apendices/${n.id.slice(9)}/`;
      return `${base}/art/${n.a}/#${n.id}`;
    };
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    // --------------------------------------------------------- resaltado
    // Al pasar sobre un punto, o al elegirlo, se encienden él, sus vecinos y
    // las líneas entre ellos; lo demás se apaga hacia el fondo.
    let foco = null;
    const vecinos = new Set();
    const lineas = new Set();
    const ocultos = new Set();
    const mezcla = (hex, t) => {
      const a = parseInt(hex.slice(1), 16);
      const r = (a >> 16) & 255, g = (a >> 8) & 255, b = a & 255;
      const f = (c, d) => Math.round(c * t + d * (1 - t));
      return `rgb(${f(r, 13)},${f(g, 14)},${f(b, 18)})`;
    };
    const apagado = Object.fromEntries(grupos.map((x) => [x.g, mezcla(x.color, 0.12)]));

    function enfocar(n) {
      foco = n;
      vecinos.clear(); lineas.clear();
      if (n) {
        vecinos.add(n.id);
        for (const id of entran.get(n.id) || []) vecinos.add(id);
        for (const id of salen.get(n.id) || []) vecinos.add(id);
        for (const l of links) {
          if (l.e) continue;
          const s = l.source.id ?? l.source, t = l.target.id ?? l.target;
          if (s === n.id || t === n.id) lineas.add(l);
        }
      }
      G.nodeColor(G.nodeColor()).linkWidth(G.linkWidth())
       .linkDirectionalParticles(G.linkDirectionalParticles()).linkColor(G.linkColor());
    }

    // -------------------------------------------------------------- mapa
    const visible = (n) => !ocultos.has(n.g);
    const G = ForceGraph3D({ controlType: 'orbit' })(lienzo)
      .backgroundColor('#0d0e12')
      .showNavInfo(false)
      .graphData({ nodes: datos.nodes, links })
      .nodeId('id')
      .nodeRelSize(2.6)
      .nodeVal((n) => (n.k === 'a' ? 7 + n.n * 0.5 : n.k === 'h' ? 7 : 0.7 + n.n * 0.45))
      .nodeColor((n) => (!foco || vecinos.has(n.id) ? color[n.g] : apagado[n.g]))
      .nodeOpacity(0.95)
      .nodeResolution(10)
      .nodeVisibility(visible)
      .nodeLabel((n) => `<b style="font-family:var(--mono)">${esc(rotulo(n))}</b>`
        + (n.k === 's' && n.t ? ` · ${esc(n.t)}` : n.k === 'a' ? ` · ${esc(n.t)}` : '')
        + `<br><span style="color:#aeaeb7">La citan ${n.n} · cita a ${(salen.get(n.id) || []).length}</span>`)
      .linkVisibility((l) => !l.e && visible(l.source) && visible(l.target))
      .linkColor((l) => (lineas.has(l) ? '#ffffff' : foco ? '#1c1e25' : color[l.source.g] || '#9a9ca8'))
      .linkOpacity(0.16)
      .linkWidth((l) => (lineas.has(l) ? 0.6 : 0))
      .linkDirectionalParticles((l) => (lineas.has(l) ? 3 : 0))
      .linkDirectionalParticleWidth(1.8)
      .linkDirectionalParticleSpeed(0.006)
      .onNodeHover((n) => {
        lienzo.style.cursor = n ? 'pointer' : '';
        if (!panelAbierto) enfocar(n);
      })
      .onNodeClick((n) => elegir(n))
      .onBackgroundClick(() => cerrar())
      .warmupTicks(80)
      .cooldownTicks(220);

    // Las secciones se pegan a su artículo; las referencias tiran poco, para
    // que los racimos se lean y los artículos más citados queden al centro.
    G.d3Force('link')
      .distance((l) => (l.e ? 4 : 60))
      .strength((l) => (l.e ? 0.9 : 0.04));
    G.d3Force('charge').strength(-22);

    let encuadrado = false;
    G.onEngineStop(() => {
      if (!encuadrado) { encuadrado = true; G.zoomToFit(900, 30); }
    });

    new ResizeObserver(() => {
      G.width(lienzo.clientWidth).height(lienzo.clientHeight);
    }).observe(lienzo);
    estado.hidden = true;

    // --------------------------------------------------------------- panel
    const panel = raiz.querySelector('.mapa-panel');
    let panelAbierto = false;

    function lista(ul, ids) {
      ul.replaceChildren();
      if (!ids.length) {
        const li = document.createElement('li');
        li.className = 'mp-vacio';
        li.textContent = 'Ninguna';
        ul.append(li);
        return;
      }
      const orden = ids.map((id) => porId.get(id)).filter(Boolean).sort((a, b) => b.n - a.n);
      for (const n of orden) {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        const i = document.createElement('i');
        i.style.background = color[n.g];
        const id = document.createElement('b');
        id.textContent = rotulo(n);
        const t = document.createElement('span');
        t.textContent = n.k === 'a' ? n.t : n.k === 's' ? n.t : '';
        b.append(i, id, t);
        b.addEventListener('click', () => elegir(n));
        li.append(b);
        ul.append(li);
      }
    }

    function elegir(n) {
      if (!n) return;
      panelAbierto = true;
      enfocar(n);
      panel.hidden = false;
      panel.querySelector('.mp-id').textContent = rotulo(n);
      panel.querySelector('.mp-id').style.color = color[n.g];
      panel.querySelector('.mp-t').textContent = n.k === 'h' ? n.t.split(' · ').slice(1).join(' · ') || n.t : n.t || rotulo(n);
      panel.querySelector('.mp-art').textContent =
        n.k === 's' ? `Artículo ${n.a} · Capítulo ${nombreGrupo[n.g] && n.g !== 'g' ? nombreGrupo[n.g] : 'general'}`
        : n.k === 'a' ? `Capítulo ${n.g !== 'g' ? nombreGrupo[n.g] : 'general'}` : 'Cierre de la norma';
      panel.querySelector('.mp-ir').href = href(n);
      const inn = entran.get(n.id) || [];
      const out = salen.get(n.id) || [];
      panel.querySelector('.mp-n-in').textContent = inn.length;
      panel.querySelector('.mp-n-out').textContent = out.length;
      lista(panel.querySelector('.mp-in'), inn);
      lista(panel.querySelector('.mp-out'), out);
      panel.scrollTop = 0;

      // Acerca la cámara al punto, desde donde está mirando ahora.
      const d = 320;
      const r = Math.hypot(n.x, n.y, n.z) || 1;
      const k = 1 + d / r;
      G.cameraPosition({ x: n.x * k, y: n.y * k, z: n.z * k }, n, 900);
      history.replaceState(null, '', `#${encodeURIComponent(n.id)}`);
    }

    function cerrar() {
      panelAbierto = false;
      panel.hidden = true;
      enfocar(null);
      history.replaceState(null, '', location.pathname);
    }
    panel.querySelector('.mapa-cerrar').addEventListener('click', cerrar);
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && panelAbierto) cerrar(); });

    // ---------------------------------------------------- ir a una sección
    const form = raiz.querySelector('.mapa-ir');
    const msg = raiz.querySelector('.mapa-ir-msg');
    function buscarNodo(q) {
      const s = q.trim().replace(/\s+/g, '').replace(/^art(ículo|iculo)?\.?/i, 'art:');
      if (!s) return null;
      if (porId.has(s)) return porId.get(s);
      if (/^\d{3}$/.test(s) && porId.has(`art:${s}`)) return porId.get(`art:${s}`);
      const m = /^(\d{3}-\d+)/.exec(s);
      if (m && porId.has(m[1])) return porId.get(m[1]);
      return null;
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = form.querySelector('input').value;
      const n = buscarNodo(q);
      if (!n) { msg.textContent = q.trim() ? 'No aparece en el mapa. Solo están las secciones que citan o son citadas.' : ''; return; }
      msg.textContent = '';
      if (ocultos.has(n.g)) alternar(n.g);
      elegir(n);
    });

    // ------------------------------------------------------------ leyenda
    function alternar(g) {
      if (ocultos.has(g)) ocultos.delete(g); else ocultos.add(g);
      raiz.querySelector(`.chip-cap[data-g="${g}"]`)?.setAttribute('aria-pressed', String(!ocultos.has(g)));
      G.nodeVisibility(G.nodeVisibility()).linkVisibility(G.linkVisibility());
    }
    for (const b of raiz.querySelectorAll('.chip-cap')) {
      b.addEventListener('click', () => alternar(b.dataset.g));
    }
    raiz.querySelector('.mapa-reset').addEventListener('click', () => {
      for (const g of [...ocultos]) alternar(g);
      cerrar();
      G.zoomToFit(900, 30);
    });

    // Un enlace directo a /mapa/#250-122 abre el mapa sobre esa sección.
    const inicial = buscarNodo(decodeURIComponent(location.hash.slice(1)));
    if (inicial) {
      let hecho = false;
      G.onEngineStop(() => {
        if (!encuadrado) { encuadrado = true; G.zoomToFit(0, 30); }
        if (!hecho) { hecho = true; elegir(inicial); }
      });
    }
  }
</script>
