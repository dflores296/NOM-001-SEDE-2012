---
import Base from '../layouts/Base.astro';
import { chapters } from '../lib/nom.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Un color por capítulo, del 2 al 9: la paleta categórica de ocho tonos,
// validada contra el fondo oscuro del visor. El Capítulo 1 (disposiciones
// generales), el 10 (tablas) y los apéndices van juntos en gris: un noveno
// tono ya no se distinguiría de los otros ocho.
const GRUPOS = [
  ...chapters.filter((c) => c.num >= 2 && c.num <= 9).map((c, i) => ({
    g: String(c.num),
    nombre: `${c.num} · ${c.title}`,
    color: ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300', '#9085e9', '#e66767'][i],
  })),
  { g: 'g', nombre: '1, 10 y apéndices · General', color: '#9a9ca8' },
];
---

<Base
  title="Mapa — NOM-001-SEDE-2012"
  desc="La NOM-001-SEDE-2012 como red en 3D: cada punto es una sección y cada línea, una referencia. Elige un punto de partida y sigue sus hilos."
>
  <div class="mapa" data-base={base} data-grupos={JSON.stringify(GRUPOS)}>
    <div class="mapa-visor">
      <div class="mapa-lienzo"></div>
      <p class="mapa-estado">Cargando el mapa…</p>

      <!-- ---------------------------------------------- barra de arriba -->
      <div class="mapa-sup">
        <div class="mapa-izq">
          <h1 class="mapa-tit"><span>Mapa</span> La norma como red</h1>
          <div class="mapa-busca">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" role="combobox" aria-expanded="false" aria-controls="mapa-sug"
                   aria-autocomplete="list" aria-label="Punto de partida"
                   placeholder="Punto de partida: 250-122, puesta a tierra…" autocomplete="off" spellcheck="false" />
            <ul id="mapa-sug" class="mapa-sug" role="listbox" hidden></ul>
          </div>
          <p class="mapa-msg" aria-live="polite"></p>

          <!-- Recorrido: los puntos por los que se ha pasado. -->
          <nav class="mapa-recorrido" aria-label="Recorrido" hidden>
            <button type="button" class="mapa-atras" aria-label="Paso anterior" title="Paso anterior">←</button>
            <ol></ol>
          </nav>
        </div>

        <div class="mapa-der">
          <div class="mapa-hilo-ctl" hidden>
            <div class="seg" role="group" aria-label="Qué hilos seguir">
              <button type="button" data-dir="ambas" aria-pressed="true">Ambas</button>
              <button type="button" data-dir="entran" aria-pressed="false">La citan</button>
              <button type="button" data-dir="salen" aria-pressed="false">Cita a</button>
            </div>
            <div class="seg" role="group" aria-label="Qué tan lejos">
              <button type="button" data-prof="1" aria-pressed="true">1 salto</button>
              <button type="button" data-prof="2" aria-pressed="false">2 saltos</button>
            </div>
          </div>
          <button type="button" class="mapa-btn mapa-red" hidden>Red completa</button>
          <button type="button" class="mapa-btn mapa-full" aria-label="Pantalla completa" title="Pantalla completa">
            <svg class="ico-entrar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
            </svg>
            <svg class="ico-salir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Cómo se lee el hilo: de izquierda a derecha, en el sentido de la cita. -->
      <p class="mapa-guia" hidden>
        <span>◀ La citan</span><b class="mapa-guia-c"></b><span>Cita a ▶</span>
      </p>
      <p class="mapa-inicio">
        Escribe arriba una sección o un tema para empezar, o haz clic en cualquier punto.
      </p>

      <div class="mapa-ley" role="group" aria-label="Capítulos visibles">
        {GRUPOS.map((x) => (
          <button type="button" class="chip-cap" data-g={x.g} aria-pressed="true" title="Mostrar u ocultar">
            <i style={`background:${x.color}`}></i>{x.nombre}
          </button>
        ))}
      </div>

      <aside class="mapa-panel" hidden aria-live="polite">
        <span class="mp-id"></span>
        <h2 class="mp-t"></h2>
        <p class="mp-art"></p>
        <a class="mp-ir">Abrir en la guía →</a>
        <div class="mp-grupo">
          <h3>La citan <b class="mp-n-in"></b></h3>
          <ul class="mp-in"></ul>
        </div>
        <div class="mp-grupo">
          <h3>Cita a <b class="mp-n-out"></b></h3>
          <ul class="mp-out"></ul>
        </div>
      </aside>
    </div>
  </div>

  {/* En el teléfono o sin mouse no se dibuja nada: ni se descargan los datos
      ni la librería 3D. */}
  <div class="wrap mapa-movil">
    <h1>Mapa de la norma</h1>
    <p class="nota">
      <span class="lb">Pantalla grande</span>
      <span>
        El mapa en 3D está hecho para una computadora con mouse. En el teléfono, cada sección
        dice en su apartado «Citado por» quién la cita, y el{' '}
        <a href={`${base}/`}>índice</a> lleva a cualquier artículo.
      </span>
    </p>
  </div>
</Base>

<style is:global>
  /* Globales y no con alcance: el panel, las sugerencias y el recorrido los
     arma el script, y lo creado así no lleva la marca de alcance de Astro.
     Todo va bajo prefijos propios (.mapa, .mp-, .chip-cap). */
  .mapa { padding: 0.8rem var(--gut) 1rem; }
  .mapa-movil { display: none; padding-top: 1.5rem; padding-bottom: 2rem; }
  .mapa-movil h1 { margin: 0 0 1rem; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; }
  @media (max-width: 1023px), (pointer: coarse) {
    .mapa { display: none; }
    .mapa-movil { display: block; }
  }

  /* ------------------------------------------------------------------ visor
     Siempre oscuro, en los dos temas: los ocho tonos de la paleta solo pasan
     contraste contra fondo oscuro. Ocupa todo el alto bajo la cabecera; el
     título y los controles flotan sobre él. */
  .mapa-visor {
    position: relative; height: calc(100vh - 64px - 1.8rem); min-height: 600px;
    border-radius: var(--radius-xl); overflow: hidden;
    background: #0d0e12; border: 1px solid #2e3038; color: #ffffff;
  }
  .mapa-visor:fullscreen { height: 100vh; border-radius: 0; border: 0; }
  .mapa-lienzo { position: absolute; inset: 0; }
  /* Con el panel abierto el lienzo se recorta, para que el hilo se encuadre
     en el espacio que queda y no debajo del panel. */
  .mapa.con-panel .mapa-lienzo { right: 360px; }
  .mapa-estado {
    position: absolute; inset: 0; margin: 0; display: grid; place-items: center;
    font-size: 0.9375rem; color: #aeaeb7; pointer-events: none;
  }
  .mapa-estado[hidden] { display: none; }

  /* --------------------------------------------------------- barra de arriba */
  .mapa-sup {
    position: absolute; top: 14px; left: 14px; right: 14px; z-index: 4;
    display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
    pointer-events: none;
  }
  .mapa-sup > * { pointer-events: auto; }
  .mapa-izq { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .mapa-tit { margin: 0 0 0.1rem; font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: #ffffff; }
  .mapa-tit span {
    margin-right: 0.4rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: #00ade4; vertical-align: 1px;
  }
  .mapa-busca { position: relative; width: 360px; }
  .mapa-busca > svg {
    position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%);
    width: 16px; height: 16px; color: #aeaeb7; pointer-events: none;
  }
  .mapa-busca input {
    width: 100%; height: 40px; padding: 0 0.9rem 0 2.3rem; font: inherit; font-size: 0.875rem; letter-spacing: inherit;
    color: #ffffff; background: rgba(13, 14, 18, 0.9); border: 1px solid #2e3038; border-radius: 999px;
  }
  .mapa-busca input::placeholder { color: #aeaeb7; }
  .mapa-busca input:focus { outline: none; border-color: #0092e4; }
  .mapa-sug {
    position: absolute; top: calc(100% + 6px); left: 0; right: 0; margin: 0; padding: 0.3rem; list-style: none;
    background: rgba(13, 14, 18, 0.97); border: 1px solid #2e3038; border-radius: var(--radius-xl);
    max-height: 340px; overflow-y: auto;
  }
  .mapa-sug[hidden] { display: none; }
  .mapa-sug li {
    display: flex; gap: 0.55rem; align-items: baseline; padding: 0.45rem 0.6rem;
    border-radius: var(--radius-lg); cursor: pointer; font-size: 0.8125rem; color: #c8cad0;
  }
  .mapa-sug li[aria-selected="true"], .mapa-sug li:hover { background: #1c1e25; color: #ffffff; }
  .mapa-sug li i { width: 8px; height: 8px; border-radius: 50%; flex: none; align-self: center; }
  .mapa-sug li b { font-family: var(--mono); font-weight: 600; color: #ffffff; flex: none; letter-spacing: normal; }
  .mapa-sug li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mapa-sug li em { margin-left: auto; font-style: normal; color: #aeaeb7; flex: none; font-variant-numeric: tabular-nums; }
  .mapa-msg { margin: 0; font-size: 0.8125rem; color: #e0b450; }
  .mapa-msg:empty { display: none; }

  .mapa-recorrido { display: flex; align-items: center; gap: 0.4rem; max-width: 640px; }
  .mapa-recorrido[hidden] { display: none; }
  .mapa-recorrido ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .mapa-recorrido li { display: flex; align-items: center; gap: 0.25rem; color: #60606c; }
  .mapa-recorrido li + li::before { content: "›"; color: #60606c; }
  .mapa-recorrido li button {
    font-family: var(--mono); font-size: 0.75rem; font-weight: 600; letter-spacing: normal;
    padding: 0.15rem 0.5rem; border-radius: 999px; cursor: pointer;
    color: #c8cad0; background: rgba(13, 14, 18, 0.85); border: 1px solid #2e3038;
  }
  .mapa-recorrido li button:hover { color: #ffffff; border-color: #aeaeb7; }
  .mapa-recorrido li button[aria-current="step"] { color: #070707; background: #ffffff; border-color: #ffffff; }
  .mapa-atras, .mapa-btn {
    height: 32px; min-width: 32px; padding: 0 0.75rem; display: inline-grid; place-items: center;
    font: inherit; font-size: 0.8125rem; font-weight: 500; color: #ffffff; cursor: pointer;
    background: rgba(13, 14, 18, 0.88); border: 1px solid #2e3038; border-radius: 999px;
  }
  .mapa-atras { padding: 0; height: 26px; min-width: 26px; font-size: 0.875rem; }
  .mapa-atras:disabled { opacity: 0.35; cursor: default; }
  .mapa-full { padding: 0; width: 32px; }
  .mapa-btn svg { width: 16px; height: 16px; }
  .mapa-full .ico-salir { display: none; }
  .mapa-visor:fullscreen .mapa-full .ico-entrar { display: none; }
  .mapa-visor:fullscreen .mapa-full .ico-salir { display: block; }
  .mapa-atras:hover:not(:disabled), .mapa-btn:hover { border-color: #aeaeb7; }
  .mapa-btn[hidden] { display: none; }

  .mapa-der { display: flex; align-items: center; gap: 0.5rem; }
  .mapa-hilo-ctl { display: flex; gap: 0.5rem; }
  .mapa-hilo-ctl[hidden] { display: none; }
  .seg { display: inline-flex; padding: 3px; gap: 2px; border-radius: 999px; background: rgba(13, 14, 18, 0.9); border: 1px solid #2e3038; }
  .seg button {
    height: 26px; padding: 0 0.7rem; border: 0; border-radius: 999px; cursor: pointer;
    font: inherit; font-size: 0.75rem; font-weight: 500; color: #c8cad0; background: transparent;
  }
  .seg button:hover { color: #ffffff; }
  .seg button[aria-pressed="true"] { color: #070707; background: #ffffff; }

  /* ------------------------------------------------------------- abajo */
  .mapa-guia, .mapa-inicio {
    position: absolute; left: 50%; bottom: 58px; transform: translateX(-50%); z-index: 3; margin: 0;
    padding: 0.4rem 1rem; border-radius: 999px; white-space: nowrap; pointer-events: none;
    background: rgba(13, 14, 18, 0.85); border: 1px solid #2e3038;
  }
  .mapa-guia { display: flex; align-items: center; gap: 1rem; font-size: 0.75rem; color: #aeaeb7; }
  .mapa-guia b { font-family: var(--mono); color: #ffffff; letter-spacing: normal; }
  .mapa-inicio { font-size: 0.8125rem; color: #c8cad0; }
  .mapa-guia[hidden], .mapa-inicio[hidden] { display: none; }
  .mapa.con-panel .mapa-guia { left: calc(50% - 180px); }

  .mapa-ley {
    position: absolute; left: 14px; bottom: 14px; right: 14px; z-index: 2;
    display: flex; flex-wrap: nowrap; gap: 0.35rem; overflow-x: auto; scrollbar-width: none;
  }
  .mapa-ley::-webkit-scrollbar { display: none; }
  .chip-cap {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 28px; padding: 0 0.7rem; flex: none;
    font: inherit; font-size: 0.75rem; color: #c8cad0; cursor: pointer; white-space: nowrap;
    background: rgba(13, 14, 18, 0.85); border: 1px solid #2e3038; border-radius: 999px;
  }
  .chip-cap i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .chip-cap[aria-pressed="false"] { opacity: 0.45; text-decoration: line-through; }
  .chip-cap:hover { border-color: #aeaeb7; color: #ffffff; }
  .mapa.con-panel .mapa-ley { right: 362px; }

  /* Panel del punto central, a la derecha. */
  .mapa-panel {
    position: absolute; top: 64px; right: 12px; bottom: 12px; width: 336px; z-index: 3;
    display: flex; flex-direction: column; gap: 0.35rem; overflow-y: auto;
    padding: 1.1rem 1.2rem 1.2rem; border-radius: var(--radius-xl);
    background: rgba(13, 14, 18, 0.93); border: 1px solid #d9dae5;
    backdrop-filter: blur(6px); color: #ffffff; scrollbar-width: thin;
  }
  .mapa-panel[hidden] { display: none; }
  .mp-id { font-family: var(--mono); font-size: 0.875rem; font-weight: 600; letter-spacing: normal; }
  .mp-t { margin: 0; font-size: 1.0625rem; font-weight: 600; line-height: 1.35; }
  .mp-art { margin: 0; font-size: 0.8125rem; color: #aeaeb7; }
  .mp-ir { font-size: 0.875rem; font-weight: 600; color: #0092e4; margin: 0.2rem 0 0.4rem; }
  .mp-grupo h3 {
    margin: 0.7rem 0 0.35rem; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: #aeaeb7;
  }
  .mp-grupo h3 b { color: #ffffff; }
  .mp-grupo ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .mp-grupo li button {
    width: 100%; display: flex; gap: 0.5rem; align-items: baseline; text-align: left;
    padding: 0.3rem 0.45rem; border: 0; border-radius: var(--radius); cursor: pointer;
    font: inherit; font-size: 0.8125rem; color: #c8cad0; background: transparent;
  }
  .mp-grupo li button:hover { background: #1c1e25; color: #ffffff; }
  .mp-grupo li button i { width: 7px; height: 7px; border-radius: 50%; flex: none; align-self: center; }
  .mp-grupo li button b { font-family: var(--mono); font-weight: 600; color: #ffffff; letter-spacing: normal; flex: none; }
  .mp-grupo li button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mp-vacio { font-size: 0.8125rem; color: #aeaeb7; padding: 0.2rem 0.45rem; }

  /* La etiqueta que la librería pone junto al cursor. */
  .mapa-visor .float-tooltip-kap,
  .mapa-visor .scene-tooltip {
    padding: 0.45rem 0.65rem !important; border-radius: var(--radius-lg) !important;
    background: rgba(13, 14, 18, 0.94) !important; border: 1px solid #2e3038;
    font: 500 0.8125rem/1.4 var(--sans) !important; color: #ffffff !important; max-width: 320px;
  }
</style>

<script>
  const raiz = document.querySelector('.mapa');
  const apto = matchMedia('(min-width: 1024px) and (pointer: fine)').matches;

  if (raiz && apto) iniciar();

  async function iniciar() {
    const base = raiz.dataset.base;
    const grupos = JSON.parse(raiz.dataset.grupos);
    const color = Object.fromEntries(grupos.map((x) => [x.g, x.color]));
    const nombreGrupo = Object.fromEntries(grupos.map((x) => [x.g, x.nombre]));
    const visor = raiz.querySelector('.mapa-visor');
    const lienzo = raiz.querySelector('.mapa-lienzo');
    const estado = raiz.querySelector('.mapa-estado');
    const $ = (s) => raiz.querySelector(s);

    let ForceGraph3D, SpriteText, datos;
    try {
      const [mod, spr, r] = await Promise.all([
        import('3d-force-graph'),
        import('three-spritetext'),
        fetch(`${base}/mapa.json`),
      ]);
      ForceGraph3D = mod.default;
      SpriteText = spr.default;
      datos = await r.json();
    } catch (e) {
      estado.textContent = 'No se pudo cargar el mapa.';
      return;
    }

    // ------------------------------------------------------------ índices
    const porId = new Map(datos.nodes.map((n) => [n.id, n]));
    const entran = new Map(); // quién cita a cada nodo
    const salen = new Map();  // a quién cita cada nodo
    const linksRed = datos.links.map((l) => ({ source: l.s, target: l.t, e: l.e || 0 }));
    for (const l of datos.links) {
      if (l.e) continue;
      if (!salen.has(l.s)) salen.set(l.s, []);
      if (!entran.has(l.t)) entran.set(l.t, []);
      salen.get(l.s).push(l.t);
      entran.get(l.t).push(l.s);
    }
    const red = { nodes: datos.nodes, links: linksRed };

    const rotulo = (n) => (n.k === 'a' ? `Art. ${n.a}` : n.k === 'h' ? n.t.split(' · ')[0] : n.id);
    const rotuloLargo = (n) => (n.k === 'a' ? `Artículo ${n.a}` : rotulo(n));
    const titulo = (n) => (n.k === 'h' ? n.t.split(' · ').slice(1).join(' · ') || n.t : n.t || '');
    const href = (n) => {
      if (n.k === 'a') return n.a === 100 ? `${base}/glosario/` : `${base}/art/${n.a}/`;
      if (n.id === 'capitulo-10') return `${base}/tablas/generales/`;
      if (n.k === 'h') return `${base}/apendices/${n.id.slice(9)}/`;
      return `${base}/art/${n.a}/#${n.id}`;
    };
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const sinAcentos = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const codigo = (s) => sinAcentos(s).replace(/[^a-z0-9]/g, '');

    // ------------------------------------------------------------- estado
    let modo = 'red';        // 'red': la norma entera · 'hilo': un punto y sus hilos
    let centro = null;       // id del punto de partida
    let dir = 'ambas';       // 'ambas' | 'entran' | 'salen'
    let prof = 1;            // 1 o 2 saltos
    let recorrido = [];      // ids visitados; el último es el centro
    let foco = null;         // en la red: el punto bajo el cursor
    const vecinos = new Set();
    const lineas = new Set();
    const ocultos = new Set();

    const mezcla = (hex, t) => {
      const a = parseInt(hex.slice(1), 16);
      const f = (c, d) => Math.round(c * t + d * (1 - t));
      return `rgb(${f((a >> 16) & 255, 13)},${f((a >> 8) & 255, 14)},${f(a & 255, 18)})`;
    };
    const apagado = Object.fromEntries(grupos.map((x) => [x.g, mezcla(x.color, 0.12)]));
    const idDe = (x) => (typeof x === 'object' ? x.id : x);

    // -------------------------------------------------------------- mapa
    const visible = (n) => !ocultos.has(n.g);
    const G = ForceGraph3D({ controlType: 'orbit' })(lienzo)
      .backgroundColor('#0d0e12')
      .showNavInfo(false)
      .nodeId('id')
      .nodeRelSize(2.6)
      .nodeOpacity(0.95)
      .nodeResolution(12)
      .linkOpacity(0.16)
      .linkDirectionalParticleWidth(1.8)
      .linkDirectionalParticleSpeed(0.006)
      .warmupTicks(80)
      .cooldownTicks(220);

    // Etiqueta 3D de un punto del hilo: su identificador, siempre de frente.
    function etiqueta(n) {
      const s = new SpriteText(rotulo(n));
      const esCentro = n.id === centro;
      s.fontFace = '"Inter Variable", system-ui, sans-serif';
      s.fontWeight = '600';
      s.textHeight = esCentro ? 10 : 6.5;
      s.color = esCentro ? '#070707' : '#ffffff';
      s.backgroundColor = esCentro ? '#ffffff' : 'rgba(13,14,18,0.78)';
      s.padding = esCentro ? 3 : 2;
      s.borderRadius = 3;
      s.position.y = Math.cbrt(G.nodeVal()(n)) * G.nodeRelSize() + (esCentro ? 12 : 8);
      return s;
    }

    function pintarRed() {
      G.nodeVal((n) => (n.k === 'a' ? 7 + n.n * 0.5 : n.k === 'h' ? 7 : 0.7 + n.n * 0.45))
        .nodeColor((n) => (!foco || vecinos.has(n.id) ? color[n.g] : apagado[n.g]))
        .nodeVisibility(visible)
        .nodeThreeObject(null)
        .nodeLabel((n) => `<b style="font-family:var(--mono)">${esc(rotuloLargo(n))}</b>`
          + (titulo(n) ? ` · ${esc(titulo(n))}` : '')
          + `<br><span style="color:#aeaeb7">La citan ${(entran.get(n.id) || []).length} · cita a ${(salen.get(n.id) || []).length} · clic para seguir sus hilos</span>`)
        .linkVisibility((l) => !l.e && visible(l.source) && visible(l.target))
        .linkColor((l) => (lineas.has(l) ? '#ffffff' : foco ? '#1c1e25' : color[l.source.g] || '#9a9ca8'))
        .linkWidth((l) => (lineas.has(l) ? 0.6 : 0))
        .linkDirectionalParticles((l) => (lineas.has(l) ? 3 : 0));
      G.cooldownTicks(220);
      G.d3Force('link').distance((l) => (l.e ? 4 : 60)).strength((l) => (l.e ? 0.9 : 0.04));
      G.d3Force('charge').strength(-22);
    }

    function resaltar(n) {
      foco = n;
      vecinos.clear(); lineas.clear();
      if (n) {
        vecinos.add(n.id);
        for (const id of entran.get(n.id) || []) vecinos.add(id);
        for (const id of salen.get(n.id) || []) vecinos.add(id);
        for (const l of linksRed) if (!l.e && (idDe(l.source) === n.id || idDe(l.target) === n.id)) lineas.add(l);
      }
      G.nodeColor(G.nodeColor()).linkWidth(G.linkWidth())
       .linkDirectionalParticles(G.linkDirectionalParticles()).linkColor(G.linkColor());
    }

    // ------------------------------------------------------- el hilo
    // El punto de partida va al centro. Lo que lo cita, a la izquierda; lo
    // que él cita, a la derecha; el segundo salto, un arco más afuera del
    // mismo lado. Así el hilo se lee de izquierda a derecha en el sentido de
    // la cita.
    const TOPE_SALTO2 = 40;
    function armarHilo(id) {
      const lado = new Map([[id, { x: 0, d: 0 }]]);
      const capa = (desde, lista, signo, d, tope = Infinity) => {
        const nuevos = [];
        for (const de of desde) for (const v of lista(de) || []) {
          if (lado.has(v) || nuevos.length >= tope) continue;
          lado.set(v, { x: signo, d });
          nuevos.push(v);
        }
        return nuevos;
      };
      const ent = (x) => entran.get(x);
      const sal = (x) => salen.get(x);
      const masCitados = (ids) => [...ids].sort((a, b) => porId.get(b).n - porId.get(a).n);
      const izq = dir !== 'salen' ? capa([id], ent, -1, 1) : [];
      const der = dir !== 'entran' ? capa([id], sal, 1, 1) : [];
      if (prof === 2) {
        // Del segundo salto, solo lo que sale de los más citados y con tope:
        // sin él, el hilo de 310-15 a dos saltos serían cientos de puntos.
        if (dir !== 'salen') capa(masCitados(izq).slice(0, 12), ent, -1, 2, TOPE_SALTO2);
        if (dir !== 'entran') capa(masCitados(der).slice(0, 12), sal, 1, 2, TOPE_SALTO2);
      }

      // Disposición fija y no simulada: cada lado es un arco alrededor del
      // centro —lo que lo cita a la izquierda, lo que cita a la derecha—,
      // ordenado de arriba abajo por cuántas citas tiene cada punto. El
      // segundo salto va en un arco más afuera. Una ligera profundidad en z
      // conserva la sensación de 3D sin estorbar la lectura.
      const ESPACIO = 22;
      const ARCO = (150 * Math.PI) / 180;
      const radio = (k, min) => Math.max(min, (k * ESPACIO) / ARCO);
      const grupo = (x, d) => [...lado].filter(([, o]) => o.x === x && o.d === d).map(([k]) => k)
        .sort((a, b) => porId.get(b).n - porId.get(a).n);
      const pos = new Map([[id, [0, 0, 0]]]);
      for (const x of [-1, 1]) {
        const g1 = grupo(x, 1);
        const g2 = grupo(x, 2);
        const r1 = radio(g1.length, 150);
        const r2 = Math.max(r1 + 170, radio(g2.length, 0));
        for (const [g, r] of [[g1, r1], [g2, r2]]) {
          g.forEach((k, j) => {
            const t = g.length === 1 ? 0.5 : j / (g.length - 1);
            const ang = (t - 0.5) * ARCO; // de arriba (−) a abajo (+)
            pos.set(k, [x * r * Math.cos(ang), -r * Math.sin(ang), 18 * Math.sin(j * 1.7)]);
          });
        }
      }
      const nodes = [...lado.keys()].map((k) => {
        const [fx, fy, fz] = pos.get(k);
        return { ...porId.get(k), fx, fy, fz, x: fx, y: fy, z: fz };
      });
      const links = [];
      for (const [k, { x, d }] of lado) {
        if (d === 0) continue;
        // Cada punto se une al de un salto más adentro, en el sentido de la cita.
        const hacia = x < 0 ? salen.get(k) || [] : entran.get(k) || [];
        for (const v of hacia) {
          const o = lado.get(v);
          if (!o || o.d !== d - 1 || (o.d > 0 && o.x !== x)) continue;
          links.push(x < 0 ? { source: k, target: v } : { source: v, target: k });
        }
      }
      return { nodes, links };
    }

    function pintarHilo() {
      G.nodeVal((n) => (n.id === centro ? 30 : n.k === 'a' ? 8 : 2 + n.n * 0.25))
        .nodeColor((n) => color[n.g])
        .nodeVisibility(visible)
        .nodeThreeObjectExtend(true)
        .nodeThreeObject((n) => etiqueta(n))
        .nodeLabel((n) => `<b style="font-family:var(--mono)">${esc(rotuloLargo(n))}</b>`
          + (titulo(n) ? ` · ${esc(titulo(n))}` : '')
          + (n.id !== centro ? '<br><span style="color:#aeaeb7">Clic para seguir desde aquí</span>' : ''))
        .linkVisibility((l) => visible(l.source) && visible(l.target))
        .linkColor(() => '#c8cad0')
        .linkWidth(0.35)
        .linkDirectionalParticles(2);
      // Todo el hilo va en posiciones fijas: no hay nada que simular.
      G.cooldownTicks(0);
    }

    // ---------------------------------------------------- moverse por el hilo
    let encuadrar = false;
    G.onEngineStop(() => {
      if (!encuadrar) return;
      encuadrar = false;
      G.zoomToFit(700, modo === 'hilo' ? 70 : 30);
    });

    function verRed({ historial = true } = {}) {
      modo = 'red';
      centro = null;
      recorrido = [];
      foco = null; vecinos.clear(); lineas.clear();
      G.graphData(red);
      pintarRed();
      encuadrar = true;
      actualizarUI();
      if (historial) history.pushState(null, '', location.pathname);
    }

    function seguir(id, { historial = true, mantener = false } = {}) {
      const n = porId.get(id);
      if (!n) return;
      modo = 'hilo';
      centro = id;
      if (!mantener) {
        const i = recorrido.indexOf(id);
        recorrido = i >= 0 ? recorrido.slice(0, i + 1) : [...recorrido, id];
      }
      G.graphData(armarHilo(id));
      pintarHilo();
      // Sin simulación, el encuadre va en cuanto el lienzo tenga su tamaño
      // (y otra vez si el lienzo cambia, ver el ResizeObserver).
      requestAnimationFrame(() => requestAnimationFrame(() => G.zoomToFit(600, 60)));
      actualizarUI();
      llenarPanel(n);
      if (historial) history.pushState(null, '', `#${encodeURIComponent(id)}`);
    }

    G.onNodeHover((n) => {
      lienzo.style.cursor = n && !(modo === 'hilo' && n.id === centro) ? 'pointer' : '';
      if (modo === 'red') resaltar(n);
    });
    G.onNodeClick((n) => { if (n.id !== centro) seguir(n.id); });

    // ------------------------------------------------------------- interfaz
    const panel = $('.mapa-panel');
    function actualizarUI() {
      const hilo = modo === 'hilo';
      $('.mapa-hilo-ctl').hidden = !hilo;
      $('.mapa-red').hidden = !hilo;
      $('.mapa-guia').hidden = !hilo;
      $('.mapa-inicio').hidden = hilo;
      $('.mapa-recorrido').hidden = !hilo;
      panel.hidden = !hilo;
      raiz.classList.toggle('con-panel', hilo);
      if (hilo) $('.mapa-guia-c').textContent = rotuloLargo(porId.get(centro));
      for (const b of raiz.querySelectorAll('[data-dir]')) b.setAttribute('aria-pressed', String(b.dataset.dir === dir));
      for (const b of raiz.querySelectorAll('[data-prof]')) b.setAttribute('aria-pressed', String(Number(b.dataset.prof) === prof));

      const ol = $('.mapa-recorrido ol');
      ol.replaceChildren();
      const desde = Math.max(0, recorrido.length - 7);
      if (desde > 0) {
        const li = document.createElement('li');
        li.textContent = '…';
        ol.append(li);
      }
      for (const id of recorrido.slice(desde)) {
        const n = porId.get(id);
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = rotulo(n);
        b.title = titulo(n);
        if (id === centro) b.setAttribute('aria-current', 'step');
        b.addEventListener('click', () => { if (id !== centro) seguir(id); });
        li.append(b);
        ol.append(li);
      }
      $('.mapa-atras').disabled = recorrido.length < 2;
    }

    function lista(ul, ids) {
      ul.replaceChildren();
      if (!ids.length) {
        const li = document.createElement('li');
        li.className = 'mp-vacio';
        li.textContent = 'Ninguna';
        ul.append(li);
        return;
      }
      const orden = ids.map((id) => porId.get(id)).filter(Boolean).sort((a, b) => b.n - a.n);
      for (const n of orden) {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        const i = document.createElement('i');
        i.style.background = color[n.g];
        const id = document.createElement('b');
        id.textContent = rotulo(n);
        const t = document.createElement('span');
        t.textContent = titulo(n);
        b.append(i, id, t);
        b.addEventListener('click', () => seguir(n.id));
        li.append(b);
        ul.append(li);
      }
    }

    function llenarPanel(n) {
      panel.querySelector('.mp-id').textContent = rotuloLargo(n);
      panel.querySelector('.mp-id').style.color = color[n.g];
      panel.querySelector('.mp-t').textContent = titulo(n) || rotuloLargo(n);
      panel.querySelector('.mp-art').textContent =
        n.k === 's' ? `Artículo ${n.a} · Capítulo ${n.g !== 'g' ? nombreGrupo[n.g] : 'general'}`
        : n.k === 'a' ? `Capítulo ${n.g !== 'g' ? nombreGrupo[n.g] : 'general'}` : 'Cierre de la norma';
      panel.querySelector('.mp-ir').href = href(n);
      const inn = entran.get(n.id) || [];
      const out = salen.get(n.id) || [];
      panel.querySelector('.mp-n-in').textContent = inn.length;
      panel.querySelector('.mp-n-out').textContent = out.length;
      lista(panel.querySelector('.mp-in'), inn);
      lista(panel.querySelector('.mp-out'), out);
      panel.scrollTop = 0;
    }

    for (const b of raiz.querySelectorAll('[data-dir]')) {
      b.addEventListener('click', () => { dir = b.dataset.dir; if (centro) seguir(centro, { historial: false, mantener: true }); });
    }
    for (const b of raiz.querySelectorAll('[data-prof]')) {
      b.addEventListener('click', () => { prof = Number(b.dataset.prof); if (centro) seguir(centro, { historial: false, mantener: true }); });
    }
    $('.mapa-red').addEventListener('click', () => verRed());
    $('.mapa-atras').addEventListener('click', () => {
      if (recorrido.length > 1) seguir(recorrido[recorrido.length - 2]);
    });

    // Pantalla completa del visor; el icono cambia con el estado (CSS).
    const btnFull = $('.mapa-full');
    btnFull.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else visor.requestFullscreen?.();
    });
    document.addEventListener('fullscreenchange', () => {
      const t = document.fullscreenElement ? 'Salir de pantalla completa' : 'Pantalla completa';
      btnFull.title = t;
      btnFull.setAttribute('aria-label', t);
    });

    // Leyenda: muestra u oculta un capítulo, en la red y en el hilo.
    function alternar(g) {
      if (ocultos.has(g)) ocultos.delete(g); else ocultos.add(g);
      raiz.querySelector(`.chip-cap[data-g="${g}"]`)?.setAttribute('aria-pressed', String(!ocultos.has(g)));
      G.nodeVisibility(G.nodeVisibility()).linkVisibility(G.linkVisibility());
    }
    for (const b of raiz.querySelectorAll('.chip-cap')) b.addEventListener('click', () => alternar(b.dataset.g));

    // ----------------------------------------------- buscador con sugerencias
    // Por código (250-122, 250122, 430) o por palabras del título, sin
    // importar acentos. Primero el código exacto, luego los que empiezan
    // igual, luego por palabras; en cada grupo, los más citados primero.
    const input = $('.mapa-busca input');
    const sug = $('.mapa-sug');
    const msg = $('.mapa-msg');
    const indice = datos.nodes.map((n) => ({
      n,
      cod: codigo(n.k === 'a' ? String(n.a) : n.id),
      txt: sinAcentos(`${rotuloLargo(n)} ${titulo(n)}`),
    }));
    let opciones = [];
    let marcada = -1;

    function sugerir(q) {
      const qc = codigo(q);
      const palabras = sinAcentos(q).split(/\s+/).filter((w) => w.length > 1);
      if (!qc) return [];
      const puntaje = (x) => {
        if (x.cod === qc) return 1e6 + x.n.n;
        if (/\d/.test(qc) && x.cod.startsWith(qc)) return 1e5 + x.n.n - x.cod.length;
        if (palabras.length && palabras.every((w) => x.txt.includes(w))) return 1e3 + x.n.n;
        return -1;
      };
      return indice.map((x) => [puntaje(x), x.n]).filter(([p]) => p >= 0)
        .sort((a, b) => b[0] - a[0]).slice(0, 9).map(([, n]) => n);
    }

    function pintarSug() {
      sug.replaceChildren();
      opciones.forEach((n, j) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = `mapa-op-${j}`;
        li.setAttribute('aria-selected', String(j === marcada));
        const i = document.createElement('i');
        i.style.background = color[n.g];
        const b = document.createElement('b');
        b.textContent = rotuloLargo(n);
        const t = document.createElement('span');
        t.textContent = titulo(n);
        const em = document.createElement('em');
        em.textContent = `${(entran.get(n.id) || []).length} citas`;
        li.append(i, b, t, em);
        li.addEventListener('mousedown', (e) => { e.preventDefault(); elegir(n); });
        sug.append(li);
      });
      sug.hidden = !opciones.length;
      input.setAttribute('aria-expanded', String(!sug.hidden));
      if (marcada >= 0) input.setAttribute('aria-activedescendant', `mapa-op-${marcada}`);
      else input.removeAttribute('aria-activedescendant');
    }

    function elegir(n) {
      opciones = []; marcada = -1; pintarSug();
      input.value = '';
      input.blur();
      msg.textContent = '';
      if (ocultos.has(n.g)) alternar(n.g);
      recorrido = [];
      seguir(n.id);
    }

    input.addEventListener('input', () => {
      const q = input.value.trim();
      opciones = q.length >= 2 ? sugerir(q) : [];
      marcada = opciones.length ? 0 : -1;
      msg.textContent = q.length >= 2 && !opciones.length
        ? 'No aparece en el mapa. Solo están las secciones que citan o son citadas.' : '';
      pintarSug();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!opciones.length) return;
        e.preventDefault();
        marcada = (marcada + (e.key === 'ArrowDown' ? 1 : -1) + opciones.length) % opciones.length;
        pintarSug();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (opciones[marcada]) elegir(opciones[marcada]);
      } else if (e.key === 'Escape') {
        opciones = []; pintarSug(); input.blur();
      }
    });
    input.addEventListener('blur', () => setTimeout(() => { opciones = []; pintarSug(); }, 120));

    // Escape fuera del buscador: un paso atrás, y del primero a la red.
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || modo !== 'hilo' || document.activeElement === input || document.fullscreenElement) return;
      if (recorrido.length > 1) seguir(recorrido[recorrido.length - 2]);
      else verRed();
    });

    // ------------------------------------------- enlaces y botón «atrás»
    // /mapa/#250-122 abre el hilo de esa sección, y el botón «atrás» del
    // navegador recorre el camino de vuelta.
    const desdeHash = () => porId.get(decodeURIComponent(location.hash.slice(1)));
    addEventListener('popstate', () => {
      const n = desdeHash();
      if (n) seguir(n.id, { historial: false });
      else verRed({ historial: false });
    });

    // Al cambiar el lienzo —al cargar, al abrir o cerrar el panel, en
    // pantalla completa— el hilo se vuelve a encuadrar: sus posiciones son
    // fijas, así que no hay simulación que lo haga sola.
    let reencuadre = 0;
    new ResizeObserver(() => {
      G.width(lienzo.clientWidth).height(lienzo.clientHeight);
      if (modo !== 'hilo') return;
      clearTimeout(reencuadre);
      reencuadre = setTimeout(() => G.zoomToFit(400, 60), 80);
    }).observe(lienzo);
    estado.hidden = true;

    const inicial = desdeHash();
    if (inicial) seguir(inicial.id, { historial: false });
    else verRed({ historial: false });
  }
</script>
