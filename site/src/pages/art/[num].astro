---
import Base from '../../layouts/Base.astro';
import Sub from '../../components/Sub.astro';
import Tabla from '../../components/Tabla.astro';
import { articles, chapters, linkify, backlinks, tablasPorArticulo, tablaSlug, BASE }
  from '../../lib/nom.js';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { num: String(a.num) }, props: { a } }));
}

const { a } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chap = chapters.find((c) => c.num === a.chapter);

// Las secciones se agrupan por parte respetando el orden del documento.
const groups = [];
for (const s of a.sections) {
  const last = groups[groups.length - 1];
  if (last && last.part === s.part) last.secs.push(s);
  else groups.push({ part: s.part, secs: [s] });
}
const partTitle = (l) => a.parts.find((p) => p.letter === l)?.title || '';

const ordered = articles.map((x) => x.num);
const i = ordered.indexOf(a.num);
const prev = i > 0 ? articles[i - 1] : null;
const next = i < articles.length - 1 ? articles[i + 1] : null;

const bl = Object.fromEntries(a.sections.map((s) => [s.id, backlinks(s.id)]));

// Cada tabla se coloca tras la última sección que la precede en el documento,
// que es donde el texto la invoca; así se lee en su contexto en lugar de
// quedar amontonada al final del artículo.
const tabs = tablasPorArticulo.get(a.num) || [];
const trasSeccion = new Map();
const sueltas = [];
for (const t of tabs) {
  let prev = null;
  for (const s of a.sections) {
    if ((s.page ?? 0) <= t.page) prev = s.id;
    else break;
  }
  if (prev) {
    if (!trasSeccion.has(prev)) trasSeccion.set(prev, []);
    trasSeccion.get(prev).push(t);
  } else sueltas.push(t);
}
---

<Base
  title={`Artículo ${a.num} — ${a.title} | NOM-001-SEDE-2012`}
  desc={`Artículo ${a.num} de la NOM-001-SEDE-2012: ${a.title}. ${a.sections.length} secciones, con referencias cruzadas navegables.`}
>
  <div class="wrap cols">
    <!-- ------------------------------------------------ navegación lateral -->
    <aside class="side">
      <h3>Capítulo {a.chapter}</h3>
      {articles
        .filter((x) => x.chapter === a.chapter)
        .map((x) => (
          <a href={`${base}/art/${x.num}`} class={x.num === a.num ? 'on' : ''}>
            <span class="mono">{x.num}</span> {x.title}
          </a>
        ))}
    </aside>

    <!-- ------------------------------------------------------------ cuerpo -->
    <main>
      <div class="art-head">
        <div class="crumb">
          <a href={`${base}/#cap${a.chapter}`}>Capítulo {a.chapter} · {chap?.title}</a>
        </div>
        <h1><span class="art-num">Artículo {a.num}</span> — {a.title}</h1>
        <div class="meta">
          {a.sections.length} secciones · {a.parts.length} partes · página {a.page} del PDF
        </div>
      </div>

      {a.num === 100 && (
        /* El Artículo 100 son definiciones, no secciones numeradas. Las citas
           a "Artículo 100" caen aquí, así que hay que llevarlas al glosario. */
        <div class="aviso">
          Este artículo es el catálogo de definiciones de la norma y se consulta
          en el <a href={`${base}/glosario`}><b>glosario</b></a>, donde están sus
          {' '}185 términos con buscador.
        </div>
      )}

      {groups.map((g) => (
        <>
          {g.part && (
            <div class="part-head" id={`parte-${g.part}`}>
              Parte {g.part} — {partTitle(g.part)}
            </div>
          )}
          {g.secs.map((s) => (
            <section class="sec" id={s.id}>
              <h2>
                <span class="sid">{s.id}</span>{s.title}
                <a class="anchor" href={`#${s.id}`} aria-label="Enlace a esta sección">#</a>
              </h2>

              {s.text && <p set:html={linkify(s.text)} />}

              {s.figures?.map((f) => (
                <figure class="fig">
                  <img src={`${BASE}/img/${f.src}`}
                       alt={`Figura de la página ${f.page} del PDF`}
                       width={f.w} height={f.h} loading="lazy" />
                  <figcaption>Página {f.page} del PDF</figcaption>
                </figure>
              ))}

              {s.definitions?.length > 0 && (
                <dl class="defs-sec">
                  {s.definitions.map((d) => (
                    <div>
                      <dt>{d.term}</dt>
                      <dd set:html={linkify(d.text)} />
                    </div>
                  ))}
                </dl>
              )}

              {[
                ...(s.notes || []).map((n) => ({ ...n, k: 'nota' })),
                ...(s.exceptions || []).map((n) => ({ ...n, k: 'exc' })),
              ].sort((a, b) => (a.seq ?? 0) - (b.seq ?? 0)).map((n) => (
                <div class={n.k}>
                  <span class="lb">{n.label}</span><span set:html={linkify(n.text)} />
                  {n.items?.length > 0 && (
                    <ul class="anot-items">
                      {n.items.map((it) => (
                        <li><span class="lbl">({it.label})</span> <span set:html={linkify(it.text)} /></li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}

              {s.children?.length > 0 && (
                <ul class="subs">
                  {s.children.map((c) => <Sub node={c} />)}
                </ul>
              )}

              {bl[s.id]?.length > 0 && (
                <details class="backlinks">
                  <summary>
                    Citado por {bl[s.id].length} {bl[s.id].length === 1 ? 'requisito' : 'requisitos'}
                  </summary>
                  <ul>
                    {bl[s.id].map((b) => (
                      <li>
                        <a href={b.href} class="mono">{b.id}</a>
                        {b.titulo && <span> — {b.titulo}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          ))}
          {g.secs.map((s) =>
            (trasSeccion.get(s.id) || []).map((t) => <Tabla t={t} />)
          )}
        </>
      ))}

      {sueltas.map((t) => <Tabla t={t} />)}

      <nav class="pager">
        {prev && (
          <a href={`${base}/art/${prev.num}`}>← <b class="mono">{prev.num}</b> {prev.title}</a>
        )}
        {next && (
          <a class="nx" href={`${base}/art/${next.num}`}><b class="mono">{next.num}</b> {next.title} →</a>
        )}
      </nav>
    </main>

    <!-- ------------------------------------------- índice de este artículo -->
    <aside class="toc">
      <h3>En este artículo</h3>
      {a.sections.map((s) => (
        <a href={`#${s.id}`}><span class="mono">{s.id}</span> {s.title}</a>
      ))}
      {tabs.length > 0 && (
        <>
          <h3>Tablas ({tabs.length})</h3>
          {tabs.map((t) => (
            <a href={`#${tablaSlug(t.id)}`}><span class="mono">Tabla {t.id}</span></a>
          ))}
        </>
      )}
    </aside>
  </div>
</Base>
