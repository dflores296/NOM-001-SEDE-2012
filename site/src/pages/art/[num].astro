---
import Base from '../../layouts/Base.astro';
import Sub from '../../components/Sub.astro';
import Tabla from '../../components/Tabla.astro';
import { articles, chapters, linkify, backlinks, tablasPorArticulo, tablaSlug,
         tablaPorId, rotuloTabla, hrefArticulo, BASE } from '../../lib/nom.js';

// El Artículo 100 no genera página. Son las 185 definiciones, que ya viven en
// el glosario; lo que salía aquí era un cartel pidiendo ir allá. astro.config
// redirige /art/100 para que los enlaces viejos sigan llegando a su sitio.
export function getStaticPaths() {
  return articles
    .filter((a) => a.num !== 100)
    .map((a) => ({ params: { num: String(a.num) }, props: { a } }));
}

const { a } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chap = chapters.find((c) => c.num === a.chapter);

// Las secciones se agrupan por parte respetando el orden del documento.
const groups = [];
for (const s of a.sections) {
  const last = groups[groups.length - 1];
  if (last && last.part === s.part) last.secs.push(s);
  else groups.push({ part: s.part, secs: [s] });
}
const partTitle = (l) => a.parts.find((p) => p.letter === l)?.title || '';

const ordered = articles.map((x) => x.num);
const i = ordered.indexOf(a.num);
const prev = i > 0 ? articles[i - 1] : null;
const next = i < articles.length - 1 ? articles[i + 1] : null;

const bl = Object.fromEntries(a.sections.map((s) => [s.id, backlinks(s.id)]));

// Cada tabla se pinta en el punto del texto donde la norma la imprime: al
// parsear el PDF se dejó una marca en esa posición y el nodo que la recogió
// —la sección o el inciso— la lleva en `tables`. Antes se colocaban al final
// de la parte, y las 32 tablas del Artículo 310 caían juntas entre la Parte B
// y la C, cortando la lectura justo donde no toca.
const tabs = tablasPorArticulo.get(a.num) || [];
const ancladas = new Set();
const marca = (n) => {
  for (const t of n.tables || []) ancladas.add(t.id);
  for (const c of n.children || []) marca(c);
};
a.sections.forEach(marca);

// Red de seguridad: si alguna tabla no encontró su sitio en el texto, se
// publica al final del artículo en vez de desaparecer.
const sueltas = tabs.filter((t) => !ancladas.has(t.id));

const tablasDe = (n) => (n.tables || []).map((t) => tablaPorId.get(t.id)).filter(Boolean);
---

<Base
  title={`Artículo ${a.num} — ${a.title} | NOM-001-SEDE-2012`}
  desc={`Artículo ${a.num} de la NOM-001-SEDE-2012: ${a.title}. ${a.sections.length} secciones, con referencias cruzadas navegables.`}
>
  <div class="wrap cols">
    <!-- ------------------------------------------------ navegación lateral -->
    <aside class="side">
      <h3>Capítulo {a.chapter}</h3>
      {articles
        .filter((x) => x.chapter === a.chapter)
        .map((x) => (
          <a href={hrefArticulo(x.num)} class={x.num === a.num ? 'on' : ''}>
            <span class="mono">{x.num}</span> {x.title}
          </a>
        ))}
    </aside>

    <!-- ------------------------------------------------------------ cuerpo -->
    <main>
      <div class="art-head">
        <div class="crumb">
          <a href={`${base}/#cap${a.chapter}`}>Capítulo {a.chapter} · {chap?.title}</a>
        </div>
        <h1><span class="art-num">Artículo {a.num}</span> — {a.title}</h1>
        <div class="meta">
          {a.sections.length} secciones · {a.parts.length} partes · página {a.page} del PDF
        </div>
      </div>

      {groups.map((g) => (
        <>
          {g.part && (
            <div class="part-head" id={`parte-${g.part}`}>
              Parte {g.part} — {partTitle(g.part)}
            </div>
          )}
          {g.secs.map((s) => (
            <section class="sec" id={s.id}>
              <h2>
                <span class="sid">{s.id}</span>{s.title}
                <a class="anchor" href={`#${s.id}`} aria-label="Enlace a esta sección">#</a>
              </h2>

              {s.text && <p set:html={linkify(s.text)} />}

              {s.figures?.map((f) => (
                <figure class="fig">
                  <img src={`${BASE}/img/${f.src}`}
                       alt={f.caption || `Figura de la página ${f.page} del PDF`}
                       width={Math.round(f.w * 4 / 3)} height={Math.round(f.h * 4 / 3)} loading="lazy" />
                  <figcaption>{f.caption || `Página ${f.page} del PDF`}</figcaption>
                </figure>
              ))}

              {s.definitions?.length > 0 && (
                <dl class="defs-sec">
                  {s.definitions.map((d) => (
                    <div>
                      <dt>{d.term}</dt>
                      <dd set:html={linkify(d.text)} />
                    </div>
                  ))}
                </dl>
              )}

              {[
                ...(s.notes || []).map((n) => ({ ...n, k: 'nota' })),
                ...(s.exceptions || []).map((n) => ({ ...n, k: 'exc' })),
              ].sort((a, b) => (a.seq ?? 0) - (b.seq ?? 0)).map((n) => (
                <div class={n.k}>
                  <span class="lb">{n.label}</span><span set:html={linkify(n.text)} />
                  {n.items?.length > 0 && (
                    <ul class="anot-items">
                      {n.items.map((it) => (
                        <li><span class="lbl">({it.label})</span> <span set:html={linkify(it.text)} /></li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}

              {tablasDe(s).map((t) => <Tabla t={t} />)}

              {s.children?.length > 0 && (
                <ul class="subs">
                  {s.children.map((c) => <Sub node={c} />)}
                </ul>
              )}

              {bl[s.id]?.length > 0 && (
                <details class="backlinks">
                  <summary>
                    Citado por {bl[s.id].length} {bl[s.id].length === 1 ? 'requisito' : 'requisitos'}
                  </summary>
                  <ul>
                    {bl[s.id].map((b) => (
                      <li>
                        <a href={b.href} class="mono">{b.id}</a>
                        {b.titulo && <span> — {b.titulo}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          ))}
        </>
      ))}

      {sueltas.map((t) => <Tabla t={t} />)}

      <nav class="pager">
        {prev && (
          <a href={hrefArticulo(prev.num)}>← <b class="mono">{prev.num}</b> {prev.title}</a>
        )}
        {next && (
          <a class="nx" href={hrefArticulo(next.num)}><b class="mono">{next.num}</b> {next.title} →</a>
        )}
      </nav>
    </main>

    <!-- ------------------------------------------- índice de este artículo -->
    <aside class="toc">
      <h3>En este artículo</h3>
      {a.sections.map((s) => (
        <a href={`#${s.id}`}><span class="mono">{s.id}</span> {s.title}</a>
      ))}
      {tabs.length > 0 && (
        <>
          <h3>Tablas ({tabs.length})</h3>
          {tabs.map((t) => (
            <a href={`#${tablaSlug(t.id)}`}><span class="mono">{rotuloTabla(t)}</span></a>
          ))}
        </>
      )}
    </aside>
  </div>
</Base>
