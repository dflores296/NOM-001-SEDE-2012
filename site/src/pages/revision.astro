---
import Base from '../layouts/Base.astro';
import { tablas, grafo, tablaSlug } from '../lib/nom.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Cuánto se apoya la norma en cada tabla: una tabla dudosa que nadie consulta
// importa mucho menos que una fiable de la que cuelga medio capítulo. El
// número lo mide build_graph sobre el texto y no sobre las aristas del grafo,
// donde una cita desnuda como "250-122" se la lleva la SECCIÓN del mismo
// número y la tabla se queda sin crédito.
const uso = grafo.uso_tablas || {};
const usos = (t) => (uso[t.id] || {}).usos || 0;

const NUM = /(?<!\S)[-+]?\d[\d.,]*(?!\S)/g;

function señales(t) {
  const s = [];
  if (t.cols < 2) s.push('quedó en una sola columna');
  const fus = t.rows.reduce(
    (n, r) => n + r.filter((c) => (c.t.match(NUM) || []).length > 1).length, 0);
  if (fus) s.push(`${fus} celdas con varios valores juntos`);
  // Sin verticales dibujadas no hay de dónde sacar las fusiones y las
  // columnas salen de los huecos entre palabras, que es lo menos fiable.
  if (t.grid === 'huecos') s.push('sin rejilla dibujada en el PDF');
  if (t.header_rows === 0) s.push('sin encabezado detectado');
  // Una celda vacía en el encabezado junto a un título de grupo es como se ve
  // una columna inventada: el título cubre una columna de menos y la que
  // sobra queda colgando de la nada. La calidad no lo detecta.
  if (t.encabezado_dudoso) s.push('encabezado con una columna de más');
  if (t.pages.length > 1) s.push(`cruza ${t.pages.length} páginas`);
  return s;
}

// Las contrastadas a ojo contra el PDF salen de la lista: ya se revisaron,
// y dejarlas pidiendo revisión enterraría las que sí faltan.
const info = tablas
  .filter((t) => !t.verificada)
  .map((t) => {
    // El riesgo ya no es solo la calidad: un encabezado con la columna
    // fantasma es un fallo confirmado y la calidad lo da por perfecto.
    const riesgo = 1 - t.quality + (t.encabezado_dudoso ? 0.6 : 0);
    return {
      t,
      c: usos(t),
      s: señales(t),
      prio: usos(t) * riesgo + riesgo + (t.cols < 2 ? 3 : 0),
    };
  });
const verificadas = tablas.filter((t) => t.verificada);

const criticas = info.filter((x) => x.prio >= 1.0).sort((a, b) => b.prio - a.prio);
const dudosas = info
  .filter((x) => x.prio < 1.0 && x.t.quality < 0.8)
  .sort((a, b) => b.c - a.c || a.t.quality - b.t.quality);
const confianza = info
  .filter((x) => x.t.quality >= 0.95 && !x.t.encabezado_dudoso && x.c >= 5)
  .sort((a, b) => b.c - a.c);

const href = (t) =>
  t.article ? `${base}/art/${t.article}#${tablaSlug(t.id)}` : `${base}/tablas/#${tablaSlug(t.id)}`;
---

<Base
  title="Qué revisar — NOM-001-SEDE-2012"
  desc="Lista priorizada de tablas por contrastar contra el PDF del DOF."
>
  <div class="wrap">
    <div class="hero">
      <h1>Qué revisar</h1>
      <p>
        Las tablas se reconstruyeron automáticamente desde el PDF y ese proceso no es exacto.
        Esta lista está ordenada por <b>impacto por duda</b>: cuánto se apoya la norma en cada
        tabla, multiplicado por lo insegura que quedó su reconstrucción. Empezar por arriba es
        lo que más corrige por minuto invertido.
      </p>
      <p style="margin-top:.7rem">
        Cada renglón dice qué buscar y en qué página del PDF. Al abrir la tabla encontrarás un
        enlace para reportar la diferencia con el número y la página ya rellenados.
      </p>
      <div class="stats">
        <div class="stat"><b>{criticas.length}</b><span>Prioridad alta</span></div>
        <div class="stat"><b>{dudosas.length}</b><span>Dudosas</span></div>
        <div class="stat"><b>{verificadas.length}</b><span>Verificadas contra el PDF</span></div>
        <div class="stat"><b>{tablas.length}</b><span>Tablas en total</span></div>
      </div>
    </div>

    <div class="chap">
      <h2>1 · Prioridad alta</h2>
      <p class="rev-nota">
        Muy usadas y con la reconstrucción insegura: o la calidad las señala, o traen la
        firma de la columna fantasma en el encabezado. Un error aquí se propaga a muchos
        cálculos.
      </p>
      {/* Una lista vacía aquí es una buena noticia. Sin decirlo, el hueco se
          lee como si la página hubiera fallado al cargar. */}
      {criticas.length === 0 && (
        <p class="rev-vacia">Ninguna: ya están todas contrastadas contra el PDF.</p>
      )}
      <ol class="rev">
        {criticas.map(({ t, c, s }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} del PDF · {c} {c === 1 ? 'uso' : 'usos'} ·
              calidad {t.quality.toFixed(2)} · {t.rows.length}×{t.cols}
            </span>
            {s.length > 0 && <span class="rev-s">Qué buscar: {s.join(' · ')}</span>}
          </li>
        ))}
      </ol>
    </div>

    <div class="chap">
      <h2>2 · Dudosas</h2>
      <p class="rev-nota">
        Bajo el umbral de confianza, pero poco citadas. Menos urgentes.
      </p>
      {dudosas.length === 0 && (
        <p class="rev-vacia">Ninguna: ya están todas contrastadas contra el PDF.</p>
      )}
      <ol class="rev">
        {dudosas.map(({ t, c, s }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} · {c} {c === 1 ? 'uso' : 'usos'} ·
              calidad {t.quality.toFixed(2)} · {t.rows.length}×{t.cols}
            </span>
            {s.length > 0 && <span class="rev-s">Qué buscar: {s.join(' · ')}</span>}
          </li>
        ))}
      </ol>
    </div>

    <div class="chap">
      <h2>3 · Verificación de control</h2>
      <p class="rev-nota">
        Estas salieron limpias, con el encabezado bien, y son muy usadas. Conviene mirarlas
        justamente por eso: una tabla
        equivocada que <em>parece</em> correcta es más peligrosa que una marcada como dudosa.
        Basta comprobar dos o tres renglones de cada una.
      </p>
      <ol class="rev">
        {confianza.map(({ t, c }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} · {c} usos · calidad {t.quality.toFixed(2)} ·
              {' '}{t.rows.length}×{t.cols}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <div class="chap">
      <h2>Qué mirar en cada tabla</h2>
      <ul class="rev-check">
        <li><b>Número de columnas.</b> Si el PDF tiene 8 y aquí ves 5, se fusionaron.</li>
        <li><b>Celdas con varios valores.</b> Un <code>55 65 75</code> junto en una celda
          significa que la separación falló en esa fila.</li>
        <li><b>Encabezados de dos niveles.</b> Las tablas con COBRE / ALUMINIO arriba y
          60/75/90 °C abajo son las más frágiles: revisa que cada número quede bajo su
          material y su temperatura.</li>
        <li><b>Primera y última fila.</b> Es donde se cuela el título de la tabla siguiente o
          una nota al pie convertida en fila.</li>
        <li><b>Tablas que cruzan páginas.</b> Comprueba que no falten filas en la costura ni
          se repita el encabezado a media tabla.</li>
        <li><b>Notas al pie y asteriscos.</b> Hoy pueden aparecer como una fila más en vez de
          como nota.</li>
      </ul>
    </div>
  </div>
</Base>
