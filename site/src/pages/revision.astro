---
import Base from '../layouts/Base.astro';
import { tablas, grafo, tablaSlug } from '../lib/nom.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Cuánto se apoya la norma en cada tabla: una tabla dudosa que nadie consulta
// importa mucho menos que una fiable de la que cuelga medio capítulo. El
// número lo mide build_graph sobre el texto y no sobre las aristas del grafo,
// donde una cita desnuda como "250-122" se la lleva la SECCIÓN del mismo
// número y la tabla se queda sin crédito.
const uso = grafo.uso_tablas || {};
const usos = (t) => (uso[t.id] || {}).usos || 0;

const NUM = /(?<!\S)[-+]?\d[\d.,]*(?!\S)/g;

function señales(t) {
  const s = [];
  if (t.cols < 2) s.push('quedó en una sola columna');
  const fus = t.rows.reduce(
    (n, r) => n + r.filter((c) => (c.t.match(NUM) || []).length > 1).length, 0);
  if (fus) s.push(`${fus} celdas con varios valores juntos`);
  // Sin verticales dibujadas no hay de dónde sacar las fusiones y las
  // columnas salen de los huecos entre palabras, que es lo menos fiable.
  if (t.grid === 'huecos') s.push('sin rejilla dibujada en el PDF');
  if (t.header_rows === 0) s.push('sin encabezado detectado');
  // Una celda vacía en el encabezado junto a un título de grupo es como se ve
  // una columna inventada: el título cubre una columna de menos y la que
  // sobra queda colgando de la nada. La calidad no lo detecta.
  if (t.encabezado_dudoso) s.push('encabezado con una columna de más');
  if (t.pages.length > 1) s.push(`cruza ${t.pages.length} páginas`);
  return s;
}

// Las contrastadas a ojo contra el PDF salen de la lista: ya se revisaron,
// y dejarlas pidiendo revisión enterraría las que sí faltan.
const info = tablas
  .filter((t) => !t.verificada)
  .map((t) => {
    // El riesgo ya no es solo la calidad: un encabezado con la columna
    // fantasma es un fallo confirmado y la calidad lo da por perfecto.
    const riesgo = 1 - t.quality + (t.encabezado_dudoso ? 0.6 : 0);
    return {
      t,
      c: usos(t),
      s: señales(t),
      prio: usos(t) * riesgo + riesgo + (t.cols < 2 ? 3 : 0),
    };
  });
const verificadas = tablas.filter((t) => t.verificada);

const criticas = info.filter((x) => x.prio >= 1.0).sort((a, b) => b.prio - a.prio);
const dudosas = info
  .filter((x) => x.prio < 1.0 && x.t.quality < 0.8)
  .sort((a, b) => b.c - a.c || a.t.quality - b.t.quality);
const confianza = info
  .filter((x) => x.t.quality >= 0.95 && !x.t.encabezado_dudoso && x.c >= 5)
  .sort((a, b) => b.c - a.c);
// Lo que ninguna heurística marcó: ni calidad baja, ni columna fantasma, ni
// uso suficiente para "verificación de control". Que salga limpia no es lo
// mismo que fiel, y nunca se contrastó contra el PDF. Se ordenan por página
// para revisarlas de corrido.
const marcadas = new Set(
  [...criticas, ...dudosas, ...confianza].map((x) => x.t.id)
);
const sinSeñales = info
  .filter((x) => !marcadas.has(x.t.id))
  .sort((a, b) => a.t.pages[0] - b.t.pages[0] || a.t.id.localeCompare(b.t.id));

// Con las 220 contrastadas esta página dejó de ser lista de trabajo y pasó a
// ser el registro de lo que se revisó. La priorización se conserva entera —no
// se borra— porque vuelve a encenderse sola si una tabla nueva o reprocesada
// se queda sin contrastar.
const terminado = info.length === 0;

const href = (t) =>
  t.article ? `${base}/art/${t.article}#${tablaSlug(t.id)}` : `${base}/tablas/#${tablaSlug(t.id)}`;
---

<Base
  title="Revisión de tablas — NOM-001-SEDE-2012"
  desc="Estado de la revisión de las tablas contra el PDF del DOF, tabla por tabla."
>
  <div class="wrap">
    <div class="hero">
      <h1>Revisión de tablas</h1>
      {terminado ? (
        <>
          <p>
            Las tablas se reconstruyen automáticamente desde el PDF y ese proceso no es exacto,
            así que se contrastaron <b>todas</b> celda por celda contra el documento original.
            Esta página era la lista de trabajo; ahora es el registro de que no queda nada
            pendiente.
          </p>
          <p style="margin-top:.7rem">
            La versión corregida de cada tabla vive en <code>data/tablas_revisadas.json</code> y
            se aplica encima de la reconstrucción, así que sobrevive a que el corpus se regenere
            desde el PDF. Si ves una diferencia, cada tabla trae un enlace para reportarla con
            el número y la página ya rellenados.
          </p>
        </>
      ) : (
        <>
          <p>
            Las tablas se reconstruyeron automáticamente desde el PDF y ese proceso no es exacto.
            Esta lista está ordenada por <b>impacto por duda</b>: cuánto se apoya la norma en cada
            tabla, multiplicado por lo insegura que quedó su reconstrucción. Empezar por arriba es
            lo que más corrige por minuto invertido.
          </p>
          <p style="margin-top:.7rem">
            Cada renglón dice qué buscar y en qué página del PDF. Al abrir la tabla encontrarás un
            enlace para reportar la diferencia con el número y la página ya rellenados.
          </p>
        </>
      )}
      <div class="stats">
        <div class="stat"><b>{verificadas.length}</b><span>Verificadas contra el PDF</span></div>
        <div class="stat"><b>{info.length}</b><span>Por revisar</span></div>
        <div class="stat"><b>{tablas.length}</b><span>Tablas en total</span></div>
      </div>
    </div>

    {terminado && (
      <div class="aviso aviso-fuerte">
        <b>Revisión terminada: {verificadas.length} de {tablas.length}.</b> Cada tabla se
        renderizó desde el PDF en sus coordenadas y se comparó contra lo publicado. Lo que
        apareció, y quedó corregido: columnas inventadas por el reparto automático, encabezados
        corridos que dejaban cada dato bajo el título equivocado, filas de datos pintadas como
        encabezado, filas partidas en la costura entre páginas, notas al pie que se tragaban el
        artículo siguiente y glitches de fuente del PDF (<code>ºC</code> por <code>°C</code>).
        <br /><br />
        Dos tablas traen valores truncados <em>en el PDF de origen</em> —la 505-9(d)(1) y la
        922-12(a)(2)—: se dejaron tal como los imprime el DOF, no se corrigió lo que la norma
        publicó así.
      </div>
    )}

    {/* Las cuatro secciones de trabajo solo se pintan si queda algo por
        revisar. Con todo contrastado eran cuatro encabezados seguidos con un
        «Ninguna» debajo: cuatro veces la misma buena noticia, y el registro de
        lo que sí se hizo enterrado al final de la página. */}
    {!terminado && (
    <>
    <div class="chap">
      <h2>1 · Prioridad alta</h2>
      <p class="rev-nota">
        Muy usadas y con la reconstrucción insegura: o la calidad las señala, o traen la
        firma de la columna fantasma en el encabezado. Un error aquí se propaga a muchos
        cálculos.
      </p>
      {/* Una lista vacía aquí es una buena noticia. Sin decirlo, el hueco se
          lee como si la página hubiera fallado al cargar. */}
      {criticas.length === 0 && (
        <p class="rev-vacia">Ninguna: ya están todas contrastadas contra el PDF.</p>
      )}
      <ol class="rev">
        {criticas.map(({ t, c, s }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} del PDF · {c} {c === 1 ? 'uso' : 'usos'} ·
              calidad {t.quality.toFixed(2)} · {t.rows.length}×{t.cols}
            </span>
            {s.length > 0 && <span class="rev-s">Qué buscar: {s.join(' · ')}</span>}
          </li>
        ))}
      </ol>
    </div>

    <div class="chap">
      <h2>2 · Dudosas</h2>
      <p class="rev-nota">
        Bajo el umbral de confianza, pero poco citadas. Menos urgentes.
      </p>
      {dudosas.length === 0 && (
        <p class="rev-vacia">Ninguna: ya están todas contrastadas contra el PDF.</p>
      )}
      <ol class="rev">
        {dudosas.map(({ t, c, s }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} · {c} {c === 1 ? 'uso' : 'usos'} ·
              calidad {t.quality.toFixed(2)} · {t.rows.length}×{t.cols}
            </span>
            {s.length > 0 && <span class="rev-s">Qué buscar: {s.join(' · ')}</span>}
          </li>
        ))}
      </ol>
    </div>

    <div class="chap">
      <h2>3 · Verificación de control</h2>
      <p class="rev-nota">
        Estas salieron limpias, con el encabezado bien, y son muy usadas. Conviene mirarlas
        justamente por eso: una tabla
        equivocada que <em>parece</em> correcta es más peligrosa que una marcada como dudosa.
        Basta comprobar dos o tres renglones de cada una.
      </p>
      <ol class="rev">
        {confianza.map(({ t, c }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} · {c} usos · calidad {t.quality.toFixed(2)} ·
              {' '}{t.rows.length}×{t.cols}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <div class="chap">
      <h2>4 · Sin señales</h2>
      <p class="rev-nota">
        Ninguna heurística las marcó —ni calidad baja, ni columna fantasma, ni uso
        suficiente para "verificación de control"— pero eso no es lo mismo que
        fieles: nunca se han contrastado contra el PDF. Ordenadas por página para
        revisarlas de corrido.
      </p>
      {sinSeñales.length === 0 && (
        <p class="rev-vacia">Ninguna: ya están todas contrastadas contra el PDF.</p>
      )}
      <ol class="rev">
        {sinSeñales.map(({ t, c, s }) => (
          <li>
            <a href={href(t)}><b class="mono">Tabla {t.id}</b></a>
            <span class="rev-t">{t.title}</span>
            <span class="rev-m">
              pág. {t.pages.join(', ')} · {c} {c === 1 ? 'uso' : 'usos'} ·
              calidad {t.quality.toFixed(2)} · {t.rows.length}×{t.cols}
            </span>
            {s.length > 0 && <span class="rev-s">Qué buscar: {s.join(' · ')}</span>}
          </li>
        ))}
      </ol>
    </div>
    </>
    )}

    <div class="chap">
      <h2>Qué mirar si quieres comprobarla</h2>
      <p class="rev-nota">
        Esto es lo que falló al reconstruir las tablas y lo que se corrigió una por una. Sirve
        de guía si quieres contrastar alguna contra el PDF por tu cuenta: son los seis sitios
        donde se escondían los errores.
      </p>
      <ul class="rev-check">
        <li><b>Número de columnas.</b> Si el PDF tiene 8 y aquí ves 5, se fusionaron; si tiene
          3 y aquí ves 4, el reparto se inventó una.</li>
        <li><b>Celdas con varios valores.</b> Un <code>55 65 75</code> junto en una celda
          significa que la separación falló en esa fila.</li>
        <li><b>Encabezados de dos y tres niveles.</b> Las tablas con COBRE / ALUMINIO arriba y
          60/75/90 °C abajo son las más frágiles: revisa que cada número quede bajo su
          material y su temperatura.</li>
        <li><b>Dónde acaba el encabezado.</b> Era el fallo más repetido: las primeras filas de
          datos pintadas como título, con el mismo estilo y sin ser encabezado.</li>
        <li><b>Primera y última fila.</b> Es donde se cuela el título de la tabla siguiente o
          una nota al pie convertida en fila.</li>
        <li><b>Tablas que cruzan páginas.</b> Comprueba que no falten filas en la costura ni
          que una fila quede partida en dos con la mitad de las celdas vacías.</li>
        <li><b>Notas al pie.</b> Que estén, y que terminen donde termina la tabla: varias se
          pasaban de largo y arrastraban el artículo siguiente completo.</li>
      </ul>
    </div>
  </div>
</Base>
