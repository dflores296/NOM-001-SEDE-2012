---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Asistente from '../components/Asistente.astro';
import { ANALITICA } from '../lib/analitica.js';
import { ASISTENTE } from '../lib/asistente.js';
const { title, desc = 'Guía interactiva de la NOM-001-SEDE-2012, Instalaciones Eléctricas (utilización).' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pestaña activa. Los artículos cuelgan del Índice y el cierre de los
// Apéndices, que es de donde se llega a ellos.
const ruta = Astro.url.pathname.replace(base, '').replace(/\/+$/, '') || '/';
const PESTANAS = [
  { href: '/', txt: 'Índice', activa: ruta === '/' || ruta.startsWith('/art') },
  { href: '/tablas/', txt: 'Tablas', activa: ruta.startsWith('/tablas') },
  { href: '/figuras/', txt: 'Figuras', activa: ruta.startsWith('/figuras') },
  { href: '/apendices/', txt: 'Apéndices', activa: ruta.startsWith('/apendices') || ruta.startsWith('/cierre') },
  { href: '/glosario/', txt: 'Glosario', activa: ruta.startsWith('/glosario') },
  { href: '/mapa/', txt: 'Mapa', activa: ruta.startsWith('/mapa') },
  { href: '/observaciones/', txt: 'Observaciones', activa: ruta.startsWith('/observaciones') },
];
// En la portada el buscador grande de la banda hace las veces del de la
// cabecera: el de arriba nace oculto y aparece cuando el grande sale de la
// vista, para que no haya dos a la vez.
const portada = ruta === '/';
const REPO = 'https://github.com/dflores296/NOM-001-SEDE-2012';

// Vista previa al compartir un enlace (WhatsApp, Telegram, Facebook,
// LinkedIn, X): cada página con su título y su descripción, y todas con la
// misma imagen (public/ui/og.jpg, ver diseno/og.html). Las apps exigen
// direcciones completas, con dominio.
// La página 404 no tiene dirección propia: se sirve en cualquiera que no
// exista, así que no declara canónica ni og:url. (No confundir con /art/404,
// que es el Artículo 404 de la norma.)
const es404 = ruta === '/404';
const urlCompleta = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(`${base}/ui/og.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    {/* resizes-content: en el teléfono, el teclado encoge la página en vez
        de taparla, y el campo del asistente queda a la vista. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {!es404 && <link rel="canonical" href={urlCompleta} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NOM-001-SEDE-2012" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    {!es404 && <meta property="og:url" content={urlCompleta} />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NOM-001-SEDE-2012, Instalaciones Eléctricas (utilización): guía interactiva" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Se aplica ANTES de pintar. Si se hiciera al cargar el módulo, la
      // página aparecería un instante con el tema claro antes de saltar al
      // elegido, que es justo el parpadeo que molesta de noche.
      //
      // Hubo seis temas y quedan dos. Quien eligió uno de los retirados
      // tiene su nombre guardado: se traduce al que le corresponde por
      // luminosidad, y «sistema» —o nada guardado— es seguir al navegador.
      try {
        var MAPA = { claro: 'claro', sepia: 'claro', alba: 'claro', guinda: 'claro',
                     oscuro: 'oscuro', noche: 'oscuro', carbon: 'oscuro' };
        var t = MAPA[localStorage.getItem('nom-tema')];
        if (t) {
          document.documentElement.dataset.theme = t;
          localStorage.setItem('nom-tema', t);
        } else {
          localStorage.removeItem('nom-tema');
        }
        var oscuro = t ? t === 'oscuro' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.querySelector('meta[name="theme-color"]')
          .setAttribute('content', oscuro ? '#070707' : '#ffffff');
      } catch (e) {}
    </script>
  </head>
  <body>
    {/* Para quien navega con teclado o lector de pantalla: el primer Tab
        ofrece brincarse la cabecera y llegar directo al contenido. */}
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="top">
      <div class="barra">
        <a class="brand" href={`${base}/`}>NOM-001-SEDE-2012</a>

        <nav class="tabs" aria-label="Secciones de la guía">
          {PESTANAS.map((p) => (
            <a href={`${base}${p.href}`} aria-current={p.activa ? 'page' : undefined}
               >{p.txt}</a>
          ))}
        </nav>

        <div class="acciones">
          <div class:list={['search-wrap', 'search-top', { oculto: portada }]}>
            <svg class="lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input
              id="q"
              data-buscar
              type="search"
              placeholder="Buscar en la norma…"
              autocomplete="off"
              spellcheck="false"
              aria-label="Buscar en la norma"
              tabindex={portada ? -1 : undefined}
            />
            <kbd aria-hidden="true">/</kbd>
            <div class="results" role="listbox"></div>
          </div>

          {/* El repositorio, con sus estrellas. El número lo pide el navegador
              a la API de GitHub y se guarda unas horas; sin red, el botón
              sigue ahí sin el número. */}
          <a class="gh" href={REPO} aria-label="Repositorio en GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="gh-txt">GitHub</span>
            <span class="gh-n" hidden>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 01.67.42l1.88 3.8 4.2.61a.75.75 0 01.41 1.28l-3.04 2.96.72 4.18a.75.75 0 01-1.09.79L8 12.31l-3.75 1.98a.75.75 0 01-1.09-.79l.72-4.18L.84 6.36a.75.75 0 01.41-1.28l4.2-.61L7.33.67A.75.75 0 018 .25z"/></svg>
              <b></b>
            </span>
          </a>

          <button id="tema" class="theme-switch" type="button" role="switch"
                  aria-checked="false" aria-label="Tema oscuro" title="Tema oscuro">
            <span class="perilla" aria-hidden="true"></span>
            <svg class="sol" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="luna" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="bot">
      <div class="wrap pie">
        <div class="pie-marca">
          <a class="brand" href={`${base}/`}>NOM-001-SEDE-2012</a>
          <span class="pie-lema">Instalaciones Eléctricas · La técnica al servicio de la patria</span>
          <p>
            <b>No es una edición oficial.</b> Reproducción del texto publicado en el{' '}
            <b>Diario Oficial de la Federación</b> el 29 de noviembre de 2012, con fines de
            consulta: ante cualquier discrepancia prevalece el DOF. Si ves una diferencia,
            {' '}<a href={`${base}/observaciones/`}>repórtala</a>.
          </p>
        </div>
        <div class="pie-col">
          <h2>Consulta</h2>
          {PESTANAS.filter((p) => p.href !== '/observaciones/').map((p) => (
            <a href={`${base}${p.href}`}>{p.txt}</a>
          ))}
          {/* El asistente no es pestaña: vive en la burbuja de cada página.
              Aquí, su guía, solo si está conectado (src/lib/asistente.js). */}
          {ASISTENTE && <a href={`${base}/asistente/`}>El asistente</a>}
          <a href={`${base}/tablas/generales/`}>Tablas generales</a>
          <a href={`${base}/cierre/`}>Títulos de cierre</a>
        </div>
        <div class="pie-col">
          <h2>Proyecto</h2>
          <a href={`${base}/observaciones/`}>Reportar una observación</a>
          <a href={REPO}>Código en GitHub</a>
          <a href={`${REPO}/issues`}>Issues</a>
        </div>
      </div>
      <div class="wrap">
        <p class="pie-legal">
          Los textos reglamentarios no son objeto de protección por derecho de autor conforme al
          artículo 14 de la Ley Federal del Derecho de Autor. El código de este proyecto es libre.
          {ANALITICA && ' Para saber cuántas personas lo visitan, el sitio usa Cloudflare Web Analytics, que no usa cookies ni guarda datos personales.'}
        </p>
      </div>
    </footer>

    <Asistente />

    {/* El contador de visitas (src/lib/analitica.js), solo con su token. Es
        un script de afuera: la CSP lo deja pasar solo a él. */}
    {ANALITICA && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
              data-cf-beacon={JSON.stringify({ token: ANALITICA })}></script>
    )}

    <script>
      // El comportamiento de la página, una pieza por módulo (src/scripts/).
      // El orden es el de antes de separarlos: cada uno se ejecuta al cargar.
      import '../scripts/buscador/campo.js';
      import '../scripts/cabecera.js';
      import '../scripts/indice-lateral.js';
      import '../scripts/indice-movil.js';
      import '../scripts/tablas-anchas.js';
      import '../scripts/tema.js';
      import '../scripts/anclas.js';
      import '../scripts/sin-conexion.js';
      import '../scripts/asistente/burbuja.js';
    </script>
  </body>
</html>
